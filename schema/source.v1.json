{
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "ns": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "category": { "enum": ["invariants", "language", "pattern", "library", "practice", "process"] },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" }
  },
  "required": ["ns", "version"],
  "additionalProperties": false
}
