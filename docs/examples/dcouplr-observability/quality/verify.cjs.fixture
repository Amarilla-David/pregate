const assert = require('node:assert/strict');
const { exportInspection } = require('../src/export-inspection.cjs');
const confidential = { token: 'secret', password: 'secret' };
const event = { sequence: 1, timestamp: 100, raw: confidential, detail: confidential, activity: confidential };
confidential.self = confidential;
const output = exportInspection([event]);
assert.deepEqual(output, [{ sequence: 1, timestamp: 100 }]);
assert.doesNotThrow(() => JSON.stringify(output));
assert.equal(JSON.stringify(output).includes('secret'), false);
event.sequence = 99;
assert.equal(output[0].sequence, 1, 'Export retained mutable event ownership');
for (const events of [null, {}, new Array(101).fill(event), [{ sequence: 0, timestamp: 1 }],
  [{ sequence: 1, timestamp: Infinity }], [{ sequence: '1', timestamp: 1 }]])
  assert.throws(() => exportInspection(events), /Invalid/);
