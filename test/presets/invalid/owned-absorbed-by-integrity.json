{
  "preset": {
    "name": "case",
    "version": "1.0.0",
    "engine": "0.1.0",
    "sources": [
      {
        "ns": "core",
        "kind": "builtin",
        "version": "0.1.0"
      },
      {
        "ns": "local",
        "kind": "path",
        "path": ".pregate/rules"
      },
      {
        "ns": "example",
        "kind": "library",
        "version": "0.1.0"
      }
    ],
    "methodologies": [
