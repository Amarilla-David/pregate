{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "svelte/runes/no-non-rune-dollar-fn",
  "version": "1.0.0",
  "area": "runes",
  "cardinality": "singleton",
  "dimension": "svelte.dollar-fn",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "dollar-fn",
          "rule": {
            "kind": "call_expression",
            "has": {
              "field": "function",
              "regex": "^\\$[A-Z]"
            }
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} calls an unknown $Name. Only the documented runes ($state, $derived, $effect, $props, $bindable, $inspect, $host) exist."
  }
}
