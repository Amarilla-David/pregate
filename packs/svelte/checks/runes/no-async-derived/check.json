{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "svelte/runes/no-async-derived",
  "version": "1.0.0",
  "area": "runes",
  "cardinality": "singleton",
  "dimension": "svelte.async-derived",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "async-derived",
          "rule": {
            "kind": "call_expression",
            "all": [
              {
                "has": {
                  "field": "function",
                  "regex": "^\\$derived(\\.by)?$"
                }
              },
              {
                "has": {
                  "field": "arguments",
                  "has": {
                    "any": [
                      {
                        "kind": "arrow_function",
                        "regex": "^async\\b"
                      },
                      {
                        "kind": "function_expression",
                        "regex": "^async\\b"
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} passes an async callback to $derived or $derived.by. Derived runes must be synchronous so consumers read the resolved value rather than a Promise."
  }
}
