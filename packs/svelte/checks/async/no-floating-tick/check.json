{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "svelte/async/no-floating-tick",
  "version": "1.0.0",
  "area": "async",
  "cardinality": "singleton",
  "dimension": "svelte.floating-tick",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "floating-tick",
          "rule": {
            "kind": "expression_statement",
            "has": {
              "stopBy": "neighbor",
              "matches": "tick-call"
            }
          },
          "utils": {
            "tick-call": {
              "kind": "call_expression",
              "has": {
                "field": "function",
                "regex": "^tick$"
              },
              "not": {
                "inside": {
                  "kind": "await_expression"
                }
              }
            }
          }
        },
        {
          "id": "tick-then",
          "rule": {
            "kind": "call_expression",
            "all": [
              {
                "has": {
                  "field": "function",
                  "kind": "member_expression",
                  "all": [
                    {
                      "has": {
                        "field": "property",
                        "regex": "^(then|catch|finally)$"
                      }
                    },
                    {
                      "has": {
                        "field": "object",
                        "regex": "^tick\\s*\\("
                      }
                    }
                  ]
                }
              },
              {
                "not": {
                  "inside": {
                    "kind": "await_expression"
                  }
                }
              }
            ]
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} calls tick without awaiting or returning it. The update it waits for may not have run."
  }
}
