{ "$schema": "../../../../../schema/check.v1.json", "id": "sveltekit/routing/no-server-dir-import-in-universal", "version": "1.0.0", "area": "routing", "cardinality": "singleton", "dimension": "sveltekit.server-dir-import", "minSeverity": null, "params": {}, "impl": { "kind": "pattern", "patterns": { "typescript": [ { "id": "server-dir-import-in-universal", "rule": { "kind": "string_fragment", "all": [ { "regex": "^([$#]lib/|(\\.\\./)+lib/)(.+/)?server/" }, { "not": { "regex": "\\.server(\\.|$)" } } ], "inside": { "stopBy": "end", "any": [ { "kind": "import_statement", "not": { "regex": "^import\\s+type\\b" } }, { "kind": "export_statement", "not": { "regex": "^export\\s+type\\b" } }, { "kind": "call_expression", "has": { "field": "function", "kind": "import" } } ] } }, "files": [ "**/+page.ts", "**/+layout.ts", "src/hooks.ts", "src/hooks.client.ts" ] } ] } }, "phase": [ "pre", "stop", "commit", "ci" ], "feedback": { "message": "{symbol} imports a module from a server directory into code that also runs in the browser. Read it in +page.server.ts or +layout.server.ts and return public data." }}
