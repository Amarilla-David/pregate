{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "sveltekit/data/no-private-env-in-load",
  "version": "1.0.0",
  "area": "data",
  "cardinality": "singleton",
  "dimension": "sveltekit.private-env-in-load",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "private-env-in-universal",
          "rule": {
            "kind": "string_fragment",
            "regex": "\\$env/(static|dynamic)/private",
            "inside": {
              "stopBy": "end",
              "any": [
                {
                  "kind": "import_statement"
                },
                {
                  "kind": "export_statement"
                },
                {
                  "kind": "call_expression",
                  "has": {
                    "field": "function",
                    "kind": "import"
                  }
                }
              ]
            }
          },
          "files": [
            "**/+page.ts",
            "**/+layout.ts"
          ]
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} imports a private $env module from a universal load file. Private env modules are server-only; read them in +page.server.ts and return public data."
  }
}
