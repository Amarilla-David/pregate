{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "firebase/firestore/no-getdocs-without-limit",
  "version": "1.0.0",
  "area": "firestore",
  "cardinality": "singleton",
  "dimension": "firebase.firestore.getdocs-limit",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "getdocs-no-constraint",
          "rule": {
            "kind": "call_expression",
            "has": {
              "field": "function",
              "regex": "\\bgetDocs$"
            },
            "not": {
              "has": {
                "field": "arguments",
                "regex": "\\b(limit|where|orderBy|startAt|startAfter|endAt|endBefore)\\b"
              }
            }
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} reads a query with getDocs and no visible constraint. Wrap the source in query() with limit() or where() so one call cannot pull the whole collection."
  }
}
