{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "firebase/firestore/no-tx-read-after-write",
  "version": "1.0.0",
  "area": "firestore",
  "cardinality": "singleton",
  "dimension": "firebase.tx-read-after-write",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "firestore-tx-read-after-write",
          "rule": {
            "kind": "call_expression",
            "has": {
              "field": "function",
              "kind": "member_expression",
              "all": [
                {
                  "has": {
                    "field": "object",
                    "regex": "^(tx|transaction|t)$"
                  }
                },
                {
                  "has": {
                    "field": "property",
                    "regex": "^get$"
                  }
                }
              ]
            },
            "inside": {
              "stopBy": {
                "kind": "statement_block"
              },
              "follows": {
                "stopBy": "end",
                "has": {
                  "stopBy": "end",
                  "kind": "call_expression",
                  "has": {
                    "field": "function",
                    "kind": "member_expression",
                    "all": [
                      {
                        "has": {
                          "field": "object",
                          "regex": "^(tx|transaction|t)$"
                        }
                      },
                      {
                        "has": {
                          "field": "property",
                          "regex": "^(set|update|delete)$"
                        }
                      }
                    ]
                  }
                }
              },
              "inside": {
                "kind": "statement_block",
                "inside": {
                  "stopBy": "end",
                  "kind": "call_expression",
                  "has": {
                    "field": "function",
                    "regex": "(^|\\.)runTransaction$"
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} reads a document with transaction.get() after a transaction write (set, update, or delete). Firestore transactions require all reads before any write."
  }
}
