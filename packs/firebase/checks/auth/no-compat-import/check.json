{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "firebase/auth/no-compat-import",
  "version": "1.0.0",
  "area": "auth",
  "cardinality": "singleton",
  "dimension": "firebase.compat-sdk",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "compat-import",
          "rule": {
            "kind": "string_fragment",
            "regex": "^firebase/compat(/|$)",
            "inside": {
              "stopBy": "end",
              "any": [
                {
                  "kind": "import_statement"
                },
                {
                  "kind": "export_statement"
                },
                {
                  "kind": "call_expression",
                  "has": {
                    "field": "function",
                    "kind": "import"
                  }
                },
                {
                  "kind": "call_expression",
                  "has": {
                    "field": "function",
                    "regex": "^require$"
                  }
                }
              ]
            }
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} imports the Firebase compat SDK. Import the modular API from firebase/app, firebase/auth, firebase/firestore and the other modular entry points."
  }
}
