{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "supabase/client/no-unbounded-select",
  "version": "1.0.0",
  "area": "client",
  "cardinality": "singleton",
  "dimension": "supabase.unbounded-select",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "unbounded-select",
          "rule": {
            "kind": "expression_statement",
            "regex": "\\.select\\s*\\(",
            "not": {
              "regex": "\\.(range|limit|order)\\s*\\("
            }
          }
        },
        {
          "id": "assigned-select",
          "rule": {
            "kind": "variable_declarator",
            "regex": "\\.select\\s*\\(",
            "not": {
              "regex": "\\.(range|limit|order)\\s*\\("
            }
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} selects rows with no range, limit, or order in the same statement. Add .range() or .limit() so one call cannot read the whole table."
  }
}
