{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "security-audit/messaging/post-message-any-origin",
  "version": "1.0.0",
  "area": "messaging",
  "cardinality": "singleton",
  "dimension": "security-audit.messaging.post-message-target-origin",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "post-message-star",
          "rule": {
            "kind": "call_expression",
            "all": [
              {
                "has": {
                  "field": "function",
                  "kind": "member_expression",
                  "all": [
                    {
                      "has": {
                        "field": "property",
                        "regex": "^postMessage$"
                      }
                    },
                    {
                      "has": {
                        "field": "object",
                        "regex": "^(?:(?:window|globalThis|self)!?\\.)?(?:parent|opener|top)!?$|\\.contentWindow!?$"
                      }
                    }
                  ]
                }
              },
              {
                "has": {
                  "field": "arguments",
                  "has": {
                    "nthChild": 2,
                    "any": [
                      {
                        "kind": "string",
                        "regex": "^[\"']\\*[\"']$"
                      },
                      {
                        "kind": "template_string",
                        "regex": "^`\\*`$"
                      },
                      {
                        "kind": "object",
                        "has": {
                          "kind": "pair",
                          "regex": "^[\"']?targetOrigin[\"']?\\s*:\\s*[\"'`]\\*[\"'`]$"
                        }
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} sends a message to any origin. Pass the exact origin of the intended receiver."
  }
}
