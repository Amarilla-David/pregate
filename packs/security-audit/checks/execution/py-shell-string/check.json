{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "security-audit/execution/py-shell-string",
  "version": "1.0.0",
  "area": "execution",
  "cardinality": "singleton",
  "dimension": "security-audit.execution.python-shell-command",
  "minSeverity": null,
  "languages": [
    "python"
  ],
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "python": [
        {
          "id": "subprocess-shell-dynamic",
          "utils": {
            "plain-string": {
              "kind": "string",
              "not": {
                "has": {
                  "kind": "string_start",
                  "regex": "[fFtT]"
                }
              }
            },
            "literal": {
              "any": [
                {
                  "matches": "plain-string"
                },
                {
                  "kind": "concatenated_string",
                  "not": {
                    "has": {
                      "kind": "string",
                      "not": {
                        "matches": "plain-string"
                      }
                    }
                  }
                }
              ]
            },
            "constant-built": {
              "any": [
                {
                  "kind": "identifier",
                  "regex": "^[A-Z][A-Z0-9_]+$"
                },
                {
                  "kind": "binary_operator",
                  "has": {
                    "field": "operator",
                    "regex": "^[+%]$"
                  },
                  "not": {
                    "has": {
                      "stopBy": "end",
                      "kind": "identifier",
                      "not": {
                        "regex": "^[A-Z][A-Z0-9_]+$"
                      }
                    }
                  }
                },
                {
                  "kind": "string",
                  "has": {
                    "kind": "string_start",
                    "regex": "[fF]"
                  },
                  "not": {
                    "has": {
                      "kind": "interpolation",
                      "not": {
                        "has": {
                          "field": "expression",
                          "kind": "identifier",
                          "regex": "^[A-Z][A-Z0-9_]+$"
                        }
                      }
                    }
                  }
                },
                {
                  "kind": "call",
                  "all": [
                    {
                      "has": {
                        "field": "function",
                        "kind": "attribute",
                        "regex": "\\.format$",
                        "has": {
                          "field": "object",
                          "matches": "plain-string"
                        }
                      }
                    },
                    {
                      "has": {
                        "field": "arguments",
                        "regex": "^\\(\\s*[A-Z][A-Z0-9_]+(?:\\s*,\\s*[A-Z][A-Z0-9_]+)*\\s*,?\\s*\\)$"
                      }
                    }
                  ]
                }
              ]
            }
          },
          "rule": {
            "kind": "call",
            "all": [
              {
                "has": {
                  "field": "arguments",
                  "all": [
                    {
                      "has": {
                        "kind": "keyword_argument",
                        "regex": "^shell\\s*=\\s*True$"
                      }
                    },
                    {
                      "any": [
                        {
                          "has": {
                            "nthChild": 1,
                            "not": {
                              "any": [
                                {
                                  "matches": "literal"
                                },
                                {
                                  "kind": "keyword_argument"
                                },
                                {
                                  "kind": "list"
                                },
                                {
                                  "kind": "tuple"
                                },
                                {
                                  "matches": "constant-built"
                                }
                              ]
                            }
                          }
                        },
                        {
                          "has": {
                            "kind": "keyword_argument",
                            "has": {
                              "field": "name",
                              "regex": "^args$"
                            },
                            "not": {
                              "has": {
                                "field": "value",
                                "any": [
                                  {
                                    "matches": "literal"
                                  },
                                  {
                                    "kind": "list"
                                  },
                                  {
                                    "kind": "tuple"
                                  },
                                  {
                                    "matches": "constant-built"
                                  }
                                ]
                              }
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "id": "subprocess-getoutput-dynamic",
          "utils": {
            "plain-string": {
              "kind": "string",
              "not": {
                "has": {
                  "kind": "string_start",
                  "regex": "[fFtT]"
                }
              }
            },
            "literal": {
              "any": [
                {
                  "matches": "plain-string"
                },
                {
                  "kind": "concatenated_string",
                  "not": {
                    "has": {
                      "kind": "string",
                      "not": {
                        "matches": "plain-string"
                      }
                    }
                  }
                }
              ]
            },
            "constant-built": {
              "any": [
                {
                  "kind": "identifier",
                  "regex": "^[A-Z][A-Z0-9_]+$"
                },
                {
                  "kind": "binary_operator",
                  "has": {
                    "field": "operator",
                    "regex": "^[+%]$"
                  },
                  "not": {
                    "has": {
                      "stopBy": "end",
                      "kind": "identifier",
                      "not": {
                        "regex": "^[A-Z][A-Z0-9_]+$"
                      }
                    }
                  }
                },
                {
                  "kind": "string",
                  "has": {
                    "kind": "string_start",
                    "regex": "[fF]"
                  },
                  "not": {
                    "has": {
                      "kind": "interpolation",
                      "not": {
                        "has": {
                          "field": "expression",
                          "kind": "identifier",
                          "regex": "^[A-Z][A-Z0-9_]+$"
                        }
                      }
                    }
                  }
                },
                {
                  "kind": "call",
                  "all": [
                    {
                      "has": {
                        "field": "function",
                        "kind": "attribute",
                        "regex": "\\.format$",
                        "has": {
                          "field": "object",
                          "matches": "plain-string"
                        }
                      }
                    },
                    {
                      "has": {
                        "field": "arguments",
                        "regex": "^\\(\\s*[A-Z][A-Z0-9_]+(?:\\s*,\\s*[A-Z][A-Z0-9_]+)*\\s*,?\\s*\\)$"
                      }
                    }
                  ]
                }
              ]
            }
          },
          "rule": {
            "kind": "call",
            "all": [
              {
                "has": {
                  "field": "function",
                  "kind": "attribute",
                  "regex": "^subprocess\\.getstatusoutput$|^subprocess\\.getoutput$"
                }
              },
              {
                "has": {
                  "field": "arguments",
                  "has": {
                    "nthChild": 1,
                    "not": {
                      "any": [
                        {
                          "matches": "literal"
                        },
                        {
                          "kind": "keyword_argument"
                        },
                        {
                          "matches": "constant-built"
                        }
                      ]
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "id": "os-system-built-string",
          "rule": {
            "kind": "call",
            "all": [
              {
                "has": {
                  "field": "function",
                  "kind": "attribute",
                  "regex": "^os\\.(?:system|popen)$"
                }
              },
              {
                "has": {
                  "field": "arguments",
                  "has": {
                    "nthChild": 1,
                    "any": [
                      {
                        "kind": "string",
                        "has": {
                          "kind": "string_start",
                          "regex": "[fF]"
                        }
                      },
                      {
                        "kind": "binary_operator",
                        "has": {
                          "field": "operator",
                          "regex": "^[+%]$"
                        }
                      },
                      {
                        "kind": "call",
                        "has": {
                          "field": "function",
                          "kind": "attribute",
                          "regex": "\\.format$"
                        }
                      }
                    ],
                    "not": {
                      "matches": "constant-built"
                    }
                  }
                }
              }
            ]
          },
          "utils": {
            "plain-string": {
              "kind": "string",
              "not": {
                "has": {
                  "kind": "string_start",
                  "regex": "[fFtT]"
                }
              }
            },
            "constant-built": {
              "any": [
                {
                  "kind": "identifier",
                  "regex": "^[A-Z][A-Z0-9_]+$"
                },
                {
                  "kind": "binary_operator",
                  "has": {
                    "field": "operator",
                    "regex": "^[+%]$"
                  },
                  "not": {
                    "has": {
                      "stopBy": "end",
                      "kind": "identifier",
                      "not": {
                        "regex": "^[A-Z][A-Z0-9_]+$"
                      }
                    }
                  }
                },
                {
                  "kind": "string",
                  "has": {
                    "kind": "string_start",
                    "regex": "[fF]"
                  },
                  "not": {
                    "has": {
                      "kind": "interpolation",
                      "not": {
                        "has": {
                          "field": "expression",
                          "kind": "identifier",
                          "regex": "^[A-Z][A-Z0-9_]+$"
                        }
                      }
                    }
                  }
                },
                {
                  "kind": "call",
                  "all": [
                    {
                      "has": {
                        "field": "function",
                        "kind": "attribute",
                        "regex": "\\.format$",
                        "has": {
                          "field": "object",
                          "matches": "plain-string"
                        }
                      }
                    },
                    {
                      "has": {
                        "field": "arguments",
                        "regex": "^\\(\\s*[A-Z][A-Z0-9_]+(?:\\s*,\\s*[A-Z][A-Z0-9_]+)*\\s*,?\\s*\\)$"
                      }
                    }
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} runs a shell command built from a value. Pass an argument list without shell=True so the value cannot add shell syntax."
  }
}
