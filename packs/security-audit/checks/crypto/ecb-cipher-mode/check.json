{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "security-audit/crypto/ecb-cipher-mode",
  "version": "1.0.0",
  "area": "crypto",
  "cardinality": "singleton",
  "dimension": "security-audit.crypto.block-cipher-mode",
  "minSeverity": null,
  "languages": [
    "typescript"
  ],
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "create-cipher-ecb",
          "rule": {
            "kind": "call_expression",
            "all": [
              {
                "has": {
                  "field": "function",
                  "regex": "(?:^|\\.)create(?:De)?[cC]ipher(?:iv)?$"
                }
              },
              {
                "has": {
                  "field": "arguments",
                  "has": {
                    "nthChild": 1,
                    "any": [
                      {
                        "kind": "string"
                      },
                      {
                        "kind": "template_string"
                      }
                    ],
                    "regex": "(?i)^[\"'`][a-z0-9-]*-ecb[\"'`]$"
                  }
                }
              }
            ]
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} encrypts in ECB mode, which leaks repeated plaintext blocks. Use an authenticated mode such as aes-256-gcm with a fresh IV."
  }
}
