{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "redis/client/no-disconnect-without-quit",
  "version": "1.0.0",
  "area": "client",
  "cardinality": "singleton",
  "dimension": "redis.disconnect-without-quit",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "redis-abrupt-disconnect",
          "rule": {
            "kind": "call_expression",
            "has": {
              "field": "function",
              "kind": "member_expression",
              "all": [
                {
                  "has": {
                    "field": "object",
                    "regex": "^(redis|client|redisClient|sub|subscriber|pub|publisher)$"
                  }
                },
                {
                  "has": {
                    "field": "property",
                    "regex": "^disconnect$"
                  }
                }
              ]
            }
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} abruptly destroys the Redis socket with .disconnect(), dropping pending commands. Call await .quit() for a graceful shutdown."
  }
}
