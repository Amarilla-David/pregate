{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "redis/client/no-client-without-error-handler",
  "version": "1.0.0",
  "area": "client",
  "cardinality": "singleton",
  "dimension": "redis.client-error-handler",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "empty-error-handler",
          "rule": {
            "kind": "call_expression",
            "regex": "\\.on\\s*\\(\\s*[\"']error[\"']\\s*,\\s*(function\\s*\\(\\s*\\)\\s*\\{\\s*\\}|\\(\\s*\\)\\s*=>\\s*\\{\\s*\\})"
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} registers an empty error handler. Log or surface the error."
  }
}
