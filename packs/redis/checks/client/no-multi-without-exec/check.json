{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "redis/client/no-multi-without-exec",
  "version": "1.0.0",
  "area": "client",
  "cardinality": "singleton",
  "dimension": "redis.multi-requires-exec",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "bare-multi",
          "rule": {
            "kind": "expression_statement",
            "regex": "\\.multi\\s*\\(",
            "not": {
              "regex": "\\.(exec|discard)\\s*\\("
            }
          }
        },
        {
          "id": "assigned-multi",
          "rule": {
            "kind": "lexical_declaration",
            "regex": "\\.multi\\s*\\(",
            "not": {
              "regex": "\\.(exec|discard)\\s*\\("
            }
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} queues a MULTI with no exec or discard in the same statement. Queued commands never run."
  }
}
