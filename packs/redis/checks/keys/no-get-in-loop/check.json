{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "redis/keys/no-get-in-loop",
  "version": "1.0.0",
  "area": "keys",
  "cardinality": "singleton",
  "dimension": "redis.get-in-loop",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "redis-get-in-loop",
          "rule": {
            "kind": "await_expression",
            "has": {
              "kind": "call_expression",
              "has": {
                "field": "function",
                "kind": "member_expression",
                "all": [
                  {
                    "has": {
                      "field": "object",
                      "regex": "^(redis|client|cache)$"
                    }
                  },
                  {
                    "has": {
                      "field": "property",
                      "regex": "^get$"
                    }
                  }
                ]
              }
            },
            "inside": {
              "stopBy": "end",
              "kind": "@loop"
            }
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} awaits redis.get() inside a loop, paying one network round-trip per key. Batch reads with mget / mGet or a pipeline."
  }
}
