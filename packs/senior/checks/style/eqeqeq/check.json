{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "senior/style/eqeqeq",
  "version": "1.0.0",
  "area": "style",
  "cardinality": "singleton",
  "dimension": "style.eqeqeq",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "loose-eq",
          "rule": {
            "kind": "binary_expression",
            "regex": "[^=!]==[^=]|[^!]!=[^=]",
            "not": {
              "regex": "==\\s*null\\b|!=\\s*null\\b|null\\s*==|null\\s*!=|==\\s*undefined\\b|!=\\s*undefined\\b|undefined\\s*==|undefined\\s*!="
            }
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} uses loose equality. Use === or !==, except for the null check."
  }
}
