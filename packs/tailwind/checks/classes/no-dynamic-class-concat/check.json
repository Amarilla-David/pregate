{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "tailwind/classes/no-dynamic-class-concat",
  "version": "1.0.0",
  "area": "classes",
  "cardinality": "singleton",
  "dimension": "tailwind.no-dynamic-class-concat",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "dynamic-concat",
          "rule": {
            "any": [
              {
                "kind": "binary_expression",
                "regex": "\\+",
                "has": { "stopBy": "end", "kind": "identifier" },
                "inside": {
                  "stopBy": "end",
                  "regex": "className"
                }
              },
              {
                "kind": "template_substitution",
                "inside": {
                  "stopBy": "end",
                  "regex": "className"
                }
              }
            ]
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} builds className with a dynamic expression. Make each possible utility a full source literal."
  }
}
