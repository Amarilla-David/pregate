{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "tailwind/classes/no-important-modifier",
  "version": "1.0.0",
  "area": "classes",
  "cardinality": "singleton",
  "dimension": "tailwind.no-important-modifier",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "important-modifier",
          "rule": {
            "kind": "string",
            "regex": "![a-z]",
            "inside": {
              "stopBy": "end",
              "regex": "className"
            }
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} uses an important modifier in className. Remove the ! prefix and fix the specificity instead."
  }
}
