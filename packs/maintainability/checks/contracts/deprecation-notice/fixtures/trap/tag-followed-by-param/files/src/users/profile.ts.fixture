export function displayName(first: string, last: string): string {
  return `${first} ${last}`;
}

/**
 * Builds the profile title shown in the header.
 * @deprecated
 * @param first - given name
 * @param last - family name
 * @returns the title
 */
export function profileTitle(first: string, last: string): string {
  return displayName(first, last);
}
