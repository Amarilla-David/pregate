{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "ddd/immutability/readonly-fields",
  "version": "1.0.0",
  "area": "immutability",
  "cardinality": "singleton",
  "dimension": "immutability.fields",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "mutable-field",
          "utils": {
            "readonly-modifier": {
              "has": {
                "regex": "^readonly$",
                "not": {
                  "any": [
                    {
                      "kind": "property_identifier"
                    },
                    {
                      "kind": "identifier"
                    }
                  ]
                }
              }
            }
          },
          "rule": {
            "any": [
              {
                "kind": "public_field_definition",
                "not": {
                  "matches": "readonly-modifier"
                }
              },
              {
                "any": [
                  {
                    "kind": "required_parameter"
                  },
                  {
                    "kind": "optional_parameter"
                  }
                ],
                "has": {
                  "kind": "accessibility_modifier"
                },
                "not": {
                  "matches": "readonly-modifier"
                }
              }
            ]
          },
          "x-note": "Every field, including private and #private ones and constructor parameter properties, is readonly."
        },
        {
          "id": "mutation-outside-constructor",
          "utils": {
            "receiver": {
              "any": [
                {
                  "kind": "this"
                },
                {
                  "any": [
                    {
                      "kind": "parenthesized_expression"
                    },
                    {
                      "kind": "as_expression"
                    },
                    {
                      "has": {
                        "nthChild": 1,
                        "kind": "type_arguments"
                      }
                    }
                  ],
                  "has": {
                    "matches": "receiver"
                  }
                }
              ]
            },
            "this-member": {
              "any": [
                {
                  "kind": "member_expression",
                  "has": {
                    "field": "object",
                    "matches": "receiver"
                  }
                },
                {
                  "kind": "subscript_expression",
                  "has": {
                    "field": "object",
                    "matches": "receiver"
                  }
                }
              ]
            }
          },
          "rule": {
            "not": {
              "inside": {
                "stopBy": "end",
                "kind": "method_definition",
                "has": {
                  "field": "name",
                  "regex": "^constructor$"
                }
              }
            },
            "any": [
              {
                "kind": "assignment_expression",
                "has": {
                  "field": "left",
                  "matches": "this-member"
                }
              },
              {
                "kind": "augmented_assignment_expression",
                "has": {
                  "field": "left",
                  "matches": "this-member"
                }
              },
              {
                "kind": "update_expression",
                "has": {
                  "field": "argument",
                  "matches": "this-member"
                }
              },
              {
                "kind": "unary_expression",
                "regex": "^delete\\b",
                "has": {
                  "field": "argument",
                  "matches": "this-member"
                }
              },
              {
                "kind": "call_expression",
                "all": [
                  {
                    "has": {
                      "field": "function",
                      "regex": "^(Object|Reflect)\\.(assign|defineProperty|defineProperties|set)$"
                    }
                  },
                  {
                    "has": {
                      "field": "arguments",
                      "has": {
                        "nthChild": 1,
                        "matches": "receiver"
                      }
                    }
                  }
                ]
              }
            ]
          },
          "x-note": "Writes to this outside the constructor, also through a cast that sidesteps readonly ((this as any).x, (<any>this).x) or through the reflective writers on Object and Reflect. The angle-bracket cast is matched by its leading type_arguments, as in double-type-assertion."
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} declares or changes a field of an immutable value."
  }
}
