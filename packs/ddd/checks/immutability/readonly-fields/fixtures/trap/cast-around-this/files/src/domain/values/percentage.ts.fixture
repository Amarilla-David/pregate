export class Percentage {
  readonly value: number;
  readonly label: string;

  constructor(value: number) {
    this.value = value;
    this.label = `${value}%`;
  }

  clamp(): Percentage {
    (this as { value: number }).value = Math.min(100, Math.max(0, this.value));
    Object.defineProperty(this, "label", { value: `${this.value}%` });
    return this;
  }

  round(): Percentage {
    Object.assign(this as unknown as object, { value: Math.round(this.value) });
    return this;
  }
}
