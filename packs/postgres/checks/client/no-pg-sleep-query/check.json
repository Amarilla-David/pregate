{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "postgres/client/no-pg-sleep-query",
  "version": "1.0.0",
  "area": "client",
  "cardinality": "singleton",
  "dimension": "postgres.pg-sleep-query",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "pg-sleep",
          "rule": {
            "kind": "call_expression",
            "regex": "\\.query\\s*\\([^)]*pg_sleep\\s*\\("
          }
        }
      ]
    }
  },
  "phase": ["pre", "stop", "commit", "ci"],
  "feedback": {
    "message": "{symbol} runs pg_sleep in app code. It blocks a pooled connection."
  }
}
