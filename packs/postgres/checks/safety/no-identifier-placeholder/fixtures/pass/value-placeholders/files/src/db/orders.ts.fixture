import { pool } from "./pool";

export async function recentOrders(customerId: number, since: Date, page: number) {
  const res = await pool.query(
    "SELECT id, total FROM orders WHERE customer_id = $1 AND created_at > $2 ORDER BY created_at DESC LIMIT $3 OFFSET $4",
    [customerId, since, 20, page * 20],
  );
  return res.rows;
}

export async function rename(id: number, name: string) {
  await pool.query({ text: "UPDATE customers SET name = $1 WHERE id = $2", values: [name, id] });
}
