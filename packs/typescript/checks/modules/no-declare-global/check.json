{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "typescript/modules/no-declare-global",
  "version": "1.0.0",
  "area": "modules",
  "cardinality": "singleton",
  "dimension": "typescript.declare-global",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "declare-global",
          "rule": {
            "kind": "ambient_declaration",
            "regex": "^declare\\s+global\\b"
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} augments the global scope with declare global. Import what the module needs instead."
  }
}
