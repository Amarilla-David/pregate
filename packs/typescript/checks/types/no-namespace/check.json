{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "typescript/types/no-namespace",
  "version": "1.1.0",
  "area": "types",
  "cardinality": "singleton",
  "dimension": "types.namespace",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "namespace-decl",
          "rule": {
            "kind": "internal_module",
            "regex": "^\\s*namespace\\b"
          }
        },
        {
          "id": "module-keyword-namespace",
          "rule": {
            "kind": "module",
            "has": {
              "field": "name",
              "kind": "identifier"
            }
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} declares a namespace. Move the values into an ES module and export them by name. TypeScript 7 rejects a namespace written with the module keyword: write namespace, or replace the block with exports."
  }
}
