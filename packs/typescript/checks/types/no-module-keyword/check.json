{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "typescript/types/no-module-keyword",
  "version": "1.0.0",
  "area": "types",
  "cardinality": "singleton",
  "dimension": "types.module-keyword",
  "minSeverity": null,
  "params": {},
  "when": {
    "dependency": "typescript",
    "min": "7.0.0",
    "otherwise": "warn"
  },
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "module-keyword-namespace",
          "rule": {
            "kind": "module",
            "has": {
              "field": "name",
              "kind": "identifier"
            }
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} declares a namespace with the module keyword. TypeScript 7 rejects it. Write namespace, or move the values into an ES module and export them by name."
  }
}
