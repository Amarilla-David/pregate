{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "react-native/security/no-exp-dev-url",
  "version": "1.0.0",
  "area": "security",
  "cardinality": "singleton",
  "dimension": "react-native.no-exp-dev-url",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "exp-dev-url",
          "rule": {
            "kind": "call_expression",
            "all": [
              {
                "has": {
                  "field": "function",
                  "regex": "\\.openURL$"
                }
              },
              {
                "has": {
                  "field": "arguments",
                  "regex": "exp://"
                }
              }
            ]
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} opens an exp:// development URL. Production builds link through the registered app scheme, never Expo Go."
  }
}
