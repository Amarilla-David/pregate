{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "nuxt/server/no-server-import-in-app",
  "version": "1.0.0",
  "area": "server",
  "cardinality": "singleton",
  "dimension": "nuxt.no-server-import-in-app",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "server-import",
          "rule": {
            "kind": "string_fragment",
            "regex": "(^~{1,2}/|^@{1,2}/|^\\.{1,2}/)server/",
            "inside": {
              "stopBy": "end",
              "any": [
                {
                  "kind": "import_statement"
                },
                {
                  "kind": "export_statement"
                },
                {
                  "kind": "call_expression",
                  "has": {
                    "field": "function",
                    "kind": "import"
                  }
                },
                {
                  "kind": "call_expression",
                  "has": {
                    "field": "function",
                    "regex": "^require$"
                  }
                }
              ]
            }
          },
          "ignores": [
            "**/server/**",
            "server/**"
          ]
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} imports from the server directory into app code. Server modules stay server-side; expose them through a route or a shared util."
  }
}
