{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "nuxt/server/no-unvalidated-body",
  "version": "1.0.0",
  "area": "server",
  "cardinality": "singleton",
  "dimension": "nuxt.no-unvalidated-body",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "unvalidated-body",
          "rule": {
            "kind": "call_expression",
            "has": {
              "field": "function",
              "regex": "^readBody$"
            }
          },
          "files": [
            "server/**",
            "src/server/**"
          ]
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} reads the request body without validation. Use readValidatedBody with a schema so malformed payloads fail at the boundary."
  }
}
