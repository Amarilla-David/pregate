import { computed, ref } from "vue";

declare function fetchPrices(ids: string[]): Promise<number[]>;
const ids = ref<string[]>([]);

export function useCartTotal() {
  const total = computed(async function () {
    const prices = await fetchPrices(ids.value);
    return prices.reduce((sum, price) => sum + price, 0);
  });
  return { total };
}
