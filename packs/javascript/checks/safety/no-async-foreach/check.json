{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "javascript/safety/no-async-foreach",
  "version": "1.0.0",
  "area": "safety",
  "cardinality": "singleton",
  "dimension": "javascript.async-foreach",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "async-foreach",
          "rule": {
            "kind": "call_expression",
            "all": [
              {
                "has": {
                  "field": "function",
                  "kind": "member_expression",
                  "has": {
                    "field": "property",
                    "regex": "^forEach$"
                  }
                }
              },
              {
                "has": {
                  "field": "arguments",
                  "has": {
                    "nthChild": {
                      "position": 1,
                      "ofRule": {
                        "not": {
                          "kind": "comment"
                        }
                      }
                    },
                    "any": [
                      {
                        "kind": "arrow_function",
                        "regex": "^async\\b"
                      },
                      {
                        "kind": "function_expression",
                        "regex": "^async\\b"
                      }
                    ]
                  }
                }
              }
            ],
            "inside": {
              "kind": "expression_statement"
            }
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} passes an async callback to forEach and discards the result, so nothing waits for the callbacks or sees their rejections. Use for...of with await, or await Promise.all over map."
  }
}
