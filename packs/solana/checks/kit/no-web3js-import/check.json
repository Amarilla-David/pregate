{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "solana/kit/no-web3js-import",
  "version": "1.0.0",
  "area": "kit",
  "cardinality": "singleton",
  "dimension": "solana.kit-web3js",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "web3js-import",
          "rule": {
            "kind": "string_fragment",
            "regex": "@solana/web3\\.js",
            "inside": {
              "stopBy": "end",
              "any": [
                {
                  "kind": "import_statement"
                },
                {
                  "kind": "export_statement"
                },
                {
                  "kind": "call_expression",
                  "has": {
                    "field": "function",
                    "kind": "import"
                  }
                },
                {
                  "kind": "call_expression",
                  "has": {
                    "field": "function",
                    "regex": "^require$"
                  }
                }
              ]
            }
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} imports @solana/web3.js v1. New code uses @solana/kit; isolate legacy web3.js in one adapter module."
  }
}
