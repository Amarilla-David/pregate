{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "solana/tx/no-bare-confirm",
  "version": "1.0.1",
  "area": "tx",
  "cardinality": "singleton",
  "dimension": "solana.tx-confirm-blockhash",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "bare-confirm",
          "rule": {
            "kind": "call_expression",
            "all": [
              {
                "any": [
                  {
                    "has": {
                      "field": "function",
                      "regex": "confirmTransaction$"
                    }
                  },
                  {
                    "all": [
                      {
                        "pattern": "$CONFIRM($$$ARGS)"
                      },
                      {
                        "inside": {
                          "any": [
                            {
                              "kind": "program"
                            },
                            {
                              "kind": "statement_block"
                            }
                          ],
                          "stopBy": {
                            "any": [
                              {
                                "kind": "program"
                              },
                              {
                                "kind": "statement_block"
                              }
                            ]
                          },
                          "has": {
                            "kind": "lexical_declaration",
                            "regex": "^const\\b",
                            "has": {
                              "any": [
                                {
                                  "kind": "variable_declarator",
                                  "all": [
                                    {
                                      "has": {
                                        "field": "name",
                                        "pattern": "$CONFIRM"
                                      }
                                    },
                                    {
                                      "has": {
                                        "field": "value",
                                        "pattern": "$CONNECTION.confirmTransaction"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "kind": "variable_declarator",
                                  "all": [
                                    {
                                      "has": {
                                        "field": "name",
                                        "kind": "object_pattern",
                                        "has": {
                                          "kind": "pair_pattern",
                                          "all": [
                                            {
                                              "has": {
                                                "field": "key",
                                                "regex": "^confirmTransaction$"
                                              }
                                            },
                                            {
                                              "has": {
                                                "field": "value",
                                                "pattern": "$CONFIRM"
                                              }
                                            }
                                          ]
                                        }
                                      }
                                    },
                                    {
                                      "has": {
                                        "field": "value",
                                        "pattern": "$CONNECTION"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "kind": "variable_declarator",
                                  "all": [
                                    {
                                      "has": {
                                        "field": "name",
                                        "pattern": "$CONFIRM"
                                      }
                                    },
                                    {
                                      "has": {
                                        "field": "value",
                                        "pattern": "$CONNECTION.confirmTransaction.bind($CONNECTION)"
                                      }
                                    }
                                  ]
                                }
                              ]
                            }
                          }
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "not": {
                  "has": {
                    "field": "arguments",
                    "has": {
                      "kind": "object",
                      "nthChild": {
                        "position": 1,
                        "ofRule": {
                          "not": {
                            "kind": "comment"
                          }
                        }
                      },
                      "all": [
                        {
                          "has": {
                            "any": [
                              {
                                "kind": "shorthand_property_identifier",
                                "regex": "^blockhash$"
                              },
                              {
                                "kind": "pair",
                                "has": {
                                  "field": "key",
                                  "regex": "^(?:blockhash|[\"']blockhash[\"'])$"
                                }
                              }
                            ]
                          }
                        },
                        {
                          "has": {
                            "any": [
                              {
                                "kind": "shorthand_property_identifier",
                                "regex": "^lastValidBlockHeight$"
                              },
                              {
                                "kind": "pair",
                                "has": {
                                  "field": "key",
                                  "regex": "^(?:lastValidBlockHeight|[\"']lastValidBlockHeight[\"'])$"
                                }
                              }
                            ]
                          }
                        },
                        {
                          "not": {
                            "has": {
                              "kind": "spread_element"
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} confirms without an explicit blockhash and lastValidBlockHeight strategy. Review wrappers and runtime values manually."
  }
}
