{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "solana/security/no-key-logging",
  "version": "1.0.1",
  "area": "security",
  "cardinality": "singleton",
  "dimension": "solana.custody-key-logging",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "key-logging",
          "rule": {
            "kind": "call_expression",
            "all": [
              {
                "has": {
                  "field": "arguments",
                  "regex": "mnemonic|secretKey|seedPhrase|privateKey"
                }
              },
              {
                "any": [
                  {
                    "has": {
                      "field": "function",
                      "regex": "^(?:(?:globalThis|window)\\.)?(console)(?:\\.(log|info|debug|warn|error)|\\[\\s*[\"\\'](log|info|debug|warn|error)[\"\\']\\s*\\])$"
                    }
                  },
                  {
                    "all": [
                      {
                        "pattern": "$RECEIVER.$METHOD($$$ARGS)"
                      },
                      {
                        "inside": {
                          "any": [
                            {
                              "kind": "program"
                            },
                            {
                              "kind": "statement_block"
                            }
                          ],
                          "stopBy": {
                            "any": [
                              {
                                "kind": "program"
                              },
                              {
                                "kind": "statement_block"
                              }
                            ]
                          },
                          "has": {
                            "kind": "lexical_declaration",
                            "regex": "^const\\b",
                            "has": {
                              "any": [
                                {
                                  "kind": "variable_declarator",
                                  "all": [
                                    {
                                      "has": {
                                        "field": "name",
                                        "pattern": "$RECEIVER"
                                      }
                                    },
                                    {
                                      "has": {
                                        "field": "value",
                                        "pattern": "$SOURCE"
                                      }
                                    }
                                  ]
                                }
                              ]
                            }
                          }
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          },
          "constraints": {
            "METHOD": {
              "regex": "^(log|info|debug|warn|error)$"
            },
            "SOURCE": {
              "regex": "^(?:(?:globalThis|window)\\.)?(console)$"
            }
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} logs key material. Keys never leave the wallet: never ask for, log, or store seed phrases or keypairs."
  }
}
