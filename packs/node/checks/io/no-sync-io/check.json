{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "node/io/no-sync-io",
  "version": "1.0.0",
  "area": "io",
  "cardinality": "singleton",
  "dimension": "node.no-sync-io",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "sync-io",
          "rule": {
            "any": [
              {
                "kind": "call_expression",
                "has": {
                  "field": "function",
                  "kind": "member_expression",
                  "has": {
                    "field": "property",
                    "regex": "^(readFileSync|writeFileSync|appendFileSync|existsSync|mkdirSync|readdirSync|statSync|rmSync|copyFileSync|renameSync|execSync|spawnSync)$"
                  }
                }
              },
              {
                "kind": "call_expression",
                "has": {
                  "field": "function",
                  "kind": "identifier",
                  "regex": "^(readFileSync|writeFileSync|appendFileSync|existsSync|mkdirSync|readdirSync|statSync|rmSync|copyFileSync|renameSync|execSync|spawnSync)$"
                }
              }
            ]
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} calls a blocking sync API. Use the async variant and await it."
  }
}
