{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "node/security/no-create-cipher",
  "version": "1.0.0",
  "area": "security",
  "cardinality": "singleton",
  "dimension": "node.no-create-cipher",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "create-cipher",
          "rule": {
            "kind": "call_expression",
            "has": {
              "field": "function",
              "any": [
                {
                  "kind": "identifier",
                  "regex": "^(createCipher|createDecipher)$"
                },
                {
                  "kind": "member_expression",
                  "has": {
                    "field": "property",
                    "regex": "^(createCipher|createDecipher)$"
                  }
                },
                {
                  "kind": "subscript_expression",
                  "has": {
                    "field": "index",
                    "regex": "^[\"'](createCipher|createDecipher)[\"']$"
                  }
                }
              ]
            }
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} calls crypto.createCipher or createDecipher, which Node.js removed for a weak key derivation. Derive a key with scrypt and use createCipheriv with a random IV."
  }
}
