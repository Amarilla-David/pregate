{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "node/security/no-exec-sync",
  "version": "1.0.0",
  "area": "security",
  "cardinality": "singleton",
  "dimension": "node.no-exec-sync",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "exec-sync",
          "rule": {
            "kind": "call_expression",
            "has": {
              "field": "function",
              "regex": "\\b(execSync|execFileSync|spawnSync)$"
            }
          }
        }
