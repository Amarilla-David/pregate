{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "node/process/no-process-exit",
  "version": "1.0.0",
  "area": "process",
  "cardinality": "singleton",
  "dimension": "node.no-process-exit",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "process-exit",
          "rule": {
            "kind": "call_expression",
            "has": {
              "field": "function",
              "regex": "^process\\.exit$"
            }
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} terminates the process directly. Throw or set the exit code and return."
  }
}
