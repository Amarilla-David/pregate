{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "mongodb/queries/no-update-without-operator",
  "version": "1.0.0",
  "area": "queries",
  "cardinality": "singleton",
  "dimension": "mongodb.update-operators",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "update-without-operator",
          "rule": {
            "kind": "call_expression",
            "all": [
              {
                "has": {
                  "field": "function",
                  "kind": "member_expression",
                  "all": [
                    {
                      "has": {
                        "field": "property",
                        "regex": "^(updateOne|updateMany|findOneAndUpdate)$"
                      }
                    },
                    {
                      "has": {
                        "field": "object",
                        "any": [
                          {
                            "regex": "\\.collection(\\s*<[^>]*>)?\\s*(\\([^)]*\\))?$"
                          },
                          {
                            "kind": "identifier",
                            "pattern": "$COLLECTION",
                            "inside": {
                              "stopBy": "end",
                              "kind": "program",
                              "has": {
                                "stopBy": "end",
                                "kind": "variable_declarator",
                                "all": [
                                  {
                                    "has": {
                                      "field": "name",
                                      "pattern": "$COLLECTION"
                                    }
                                  },
                                  {
                                    "has": {
                                      "field": "value",
                                      "regex": "\\.collection\\s*(<[^>]*>)?\\s*\\("
                                    }
                                  }
                                ]
                              }
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              },
              {
                "has": {
                  "field": "arguments",
                  "kind": "arguments",
                  "has": {
                    "nthChild": {
                      "position": 2,
                      "ofRule": {
                        "not": {
                          "kind": "comment"
                        }
                      }
                    },
                    "kind": "object",
                    "not": {
                      "regex": "^\\{\\s*([\"'`]?\\$|\\.\\.\\.)"
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} passes an update document without update operators to a driver collection. Wrap the fields in $set (or another $ operator), or use replaceOne to replace the document."
  }
}
