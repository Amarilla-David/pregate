import type { Db, ObjectId } from "mongodb";

export async function rename(db: Db, id: ObjectId, name: string) {
  await db.collection("users").updateOne({ _id: id }, { $set: { name }, $currentDate: { updatedAt: true } });
  const views = { $inc: { views: 1 } };
  await db.collection("profiles").updateOne({ userId: id }, views);
}
