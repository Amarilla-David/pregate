{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "vibe-proof/debug/console-leftover",
  "version": "1.0.0",
  "area": "debug",
  "cardinality": "singleton",
  "dimension": "debug.console",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "console-call",
          "rule": {
            "kind": "call_expression",
            "any": [
              {
                "has": {
                  "field": "function",
                  "kind": "member_expression",
                  "all": [
                    {
                      "has": {
                        "field": "property",
                        "regex": "^(log|debug|trace|info|dir|table)$"
                      }
                    },
                    {
                      "has": {
                        "field": "object",
                        "regex": "^(console|globalThis\\.console|window\\.console)$"
                      }
                    }
                  ]
                }
              },
              {
                "has": {
                  "field": "function",
                  "kind": "subscript_expression",
                  "all": [
                    {
                      "has": {
                        "field": "object",
                        "regex": "^console$"
                      }
                    },
                    {
                      "has": {
                        "field": "index",
                        "regex": "^[\"'](log|debug|trace|info|dir|table)[\"']$"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "ignores": [
            "**/*.test.ts",
            "**/*.spec.ts",
            "**/*.test.tsx",
            "**/*.spec.tsx",
            "**/__tests__/**"
          ]
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} calls console.log or a debug printer. Use the logger, or delete it."
  }
}
