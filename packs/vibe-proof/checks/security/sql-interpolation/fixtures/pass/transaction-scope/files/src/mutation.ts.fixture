export async function mutate(db: Database, execute: Executor, id: string): Promise<unknown> {
  return db.transaction(async tx => {
    await tx.query("select id from items where id = $1", [id]);
    return execute.execute(tx, `operation:${id}`);
  });
}

interface Transaction { query(text: string, values: unknown[]): Promise<unknown> }
interface Database { transaction(run: (tx: Transaction) => Promise<unknown>): Promise<unknown> }
interface Executor { execute(tx: Transaction, scope: string): Promise<unknown> }
