{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "vibe-proof/security/dangerous-html",
  "version": "1.0.0",
  "area": "security",
  "cardinality": "singleton",
  "dimension": "security.dangerous-html",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "dangerous-html",
          "rule": {
            "any": [
              {
                "kind": "property_identifier",
                "regex": "^dangerouslySetInnerHTML$"
              },
              {
                "kind": "identifier",
                "regex": "^dangerouslySetInnerHTML$"
              }
            ]
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} sets HTML from a string. Encode the text, or sanitize a documented subset."
  }
}
