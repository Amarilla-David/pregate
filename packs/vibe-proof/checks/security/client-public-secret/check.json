  "dimension": "security.client-public-secret",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "public-secret-name",
          "rule": {
            "any": [
              {
                "kind": "identifier",
                "regex": "^(NEXT_PUBLIC|VITE|EXPO_PUBLIC)_[A-Z0-9_]*(SECRET|TOKEN|PASSWORD|SERVICE_ROLE|PRIVATE_KEY)[A-Z0-9_]*$"
              },
              {
                "kind": "property_identifier",
                "regex": "^(NEXT_PUBLIC|VITE|EXPO_PUBLIC)_[A-Z0-9_]*(SECRET|TOKEN|PASSWORD|SERVICE_ROLE|PRIVATE_KEY)[A-Z0-9_]*$"
              }
            ]
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} puts a secret-shaped name behind a client-public env prefix."
  }
