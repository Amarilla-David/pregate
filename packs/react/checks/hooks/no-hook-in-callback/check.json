{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "react/hooks/no-hook-in-callback",
  "version": "1.0.0",
  "area": "hooks",
  "cardinality": "singleton",
  "dimension": "react.hook-in-callback",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "hook-in-iterator-effect-or-promise",
          "rule": {
            "kind": "call_expression",
            "has": { "field": "function", "regex": "^use[A-Z][A-Za-z0-9]*$" },
            "inside": {
              "stopBy": "end",
              "any": [
                { "kind": "arrow_function" },
                { "kind": "function_expression" }
              ],
              "inside": {
                "stopBy": "end",
                "kind": "call_expression",
                "has": {
                  "field": "function",
                  "regex": "\\.(map|forEach|filter|reduce|then|catch)$|^(useEffect|setTimeout)$"
                }
              }
            }
          }
        }
      ]
    }
  },
  "phase": ["pre", "stop", "commit", "ci"],
  "feedback": { "message": "{symbol} calls a Hook from a callback. Call Hooks at the top level of a component or custom Hook." }
}
