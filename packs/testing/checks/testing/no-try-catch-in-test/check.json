{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "testing/testing/no-try-catch-in-test",
  "version": "1.0.0",
  "area": "testing",
  "cardinality": "singleton",
  "dimension": "testing.no-try-catch",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "no-try-catch-in-test",
          "rule": {
            "kind": "try_statement",
            "has": {
              "kind": "catch_clause"
            },
            "inside": {
              "stopBy": "end",
              "kind": "call_expression",
              "has": {
                "field": "function",
                "regex": "^(test|it)(\\.(concurrent|sequential|each|for).*|)$"
              }
            }
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} wraps test logic in a try/catch block. If the call under test does not throw, the catch assertions never run and the test passes silently; use expect(() => ...).toThrow() or expect(...).rejects."
  }
}
