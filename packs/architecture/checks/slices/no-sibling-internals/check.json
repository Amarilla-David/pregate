{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "architecture/slices/no-sibling-internals",
  "version": "1.0.0",
  "area": "slices",
  "cardinality": "singleton",
  "dimension": "slices.sibling-internals",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "import-edge",
          "rule": {
            "kind": "string_fragment",
            "regex": "\\.\\./[A-Za-z0-9_-]+/(internal|persistence|domain|infra|adapters|application)/",
            "inside": {
              "stopBy": "end",
              "any": [
                {
                  "kind": "import_statement"
                },
                {
                  "kind": "export_statement"
                },
                {
                  "kind": "call_expression",
                  "has": {
                    "field": "function",
                    "kind": "import"
                  }
                }
              ]
            }
          },
          "files": [
            "**/features/**"
          ]
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} reaches into another feature's internal folder. Cross the slice through its public entry."
  }
}
