{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "architecture/modules/no-cross-module-internals",
  "version": "1.0.0",
  "area": "modules",
  "cardinality": "singleton",
  "dimension": "modules.cross-internals",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "import-edge",
          "rule": {
            "kind": "string_fragment",
            "regex": "\\.\\./[A-Za-z0-9_-]+/(internal|persistence)/",
            "inside": {
              "stopBy": "end",
              "any": [
                {
                  "kind": "import_statement"
                },
                {
                  "kind": "export_statement"
                },
                {
                  "kind": "call_expression",
                  "has": {
                    "field": "function",
                    "kind": "import"
                  }
                }
              ]
            }
          },
          "files": [
            "**/modules/**"
          ]
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} reaches into another module's internal or persistence folder."
  }
}
