{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "architecture/layers/no-presentation-to-persistence",
  "version": "1.0.0",
  "area": "layers",
  "cardinality": "singleton",
  "dimension": "layers.presentation-persistence",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "import-edge",
          "rule": {
            "kind": "string_fragment",
            "regex": "(^|/)(persistence|repositories|dao|db)(/|$)",
            "inside": {
              "stopBy": "end",
              "any": [
                {
                  "kind": "import_statement"
                },
                {
                  "kind": "export_statement"
                },
                {
                  "kind": "call_expression",
                  "has": {
                    "field": "function",
                    "kind": "import"
                  }
                }
              ]
            }
          },
          "files": [
            "**/presentation/**",
            "**/controllers/**",
            "**/views/**",
            "**/routes/**"
          ]
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} imports persistence from presentation code in a closed layered architecture."
  }
}
