{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "architecture/layers/no-transaction-in-presentation",
  "version": "1.0.0",
  "area": "layers",
  "cardinality": "singleton",
  "dimension": "layers.presentation-transaction",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "tx-call",
          "rule": {
            "kind": "call_expression",
            "has": {
              "field": "function",
              "kind": "member_expression",
              "has": {
                "field": "property",
                "regex": "^(\\$transaction|startTransaction|beginTransaction|commit|rollback)$"
              }
            }
          },
          "files": [
            "**/presentation/**",
            "**/controllers/**",
            "**/views/**",
            "**/routes/**"
          ]
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} manages database transactions directly in presentation or controller code. Transactions belong in application or business services."
  }
}
