{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "architecture/dependency-rule/entity-imports-outer",
  "version": "1.0.0",
  "area": "dependency-rule",
  "cardinality": "singleton",
  "dimension": "dependency.entity-outer",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "import-edge",
          "rule": {
            "kind": "string_fragment",
            "regex": "(^|/)(use-cases|usecases|interface-adapters|frameworks|adapters|infra)(/|$)",
            "inside": {
              "stopBy": "end",
              "any": [
                {
                  "kind": "import_statement"
                },
                {
                  "kind": "export_statement"
                },
                {
                  "kind": "call_expression",
                  "has": {
                    "field": "function",
                    "kind": "import"
                  }
                }
              ]
            }
          },
          "files": [
            "**/entities/**"
          ]
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} imports an outer ring from an entity module. Entities sit inside use cases, adapters, and frameworks."
  }
}
