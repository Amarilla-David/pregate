                        "regex": "^(addValidationPolicy|addVerificationPolicy)$"
                      }
                    }
                  ]
                },
                {
                  "kind": "subscript_expression",
                  "all": [
                    {
                      "has": {
                        "field": "index",
                        "regex": "^[\\\"'`](addValidationPolicy|addVerificationPolicy)[\\\"'`]$"
