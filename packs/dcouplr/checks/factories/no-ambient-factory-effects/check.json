{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "dcouplr/factories/no-ambient-factory-effects",
  "version": "1.5.0",
  "area": "factories",
  "cardinality": "singleton",
  "dimension": "dcouplr.no-ambient-factory-effects",
  "minSeverity": null,
  "params": {
    "allow": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(\\.[A-Za-z_$][A-Za-z0-9_$]*)+$"
      }
    }
  },
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "nondeterministic-source",
          "utils": {
            "function-like": {
              "any": [
                {
                  "kind": "function_declaration"
                },
                {
                  "kind": "generator_function_declaration"
                },
                {
                  "kind": "function_expression"
                },
                {
                  "kind": "generator_function"
                },
                {
                  "kind": "arrow_function"
                },
                {
                  "kind": "method_definition"
                }
              ]
            },
            "scope": {
              "any": [
                {
                  "kind": "program"
                },
                {
                  "kind": "statement_block"
                },
                {
                  "kind": "switch_body"
                },
                {
                  "kind": "for_statement"
                },
                {
                  "kind": "for_in_statement"
                },
                {
                  "kind": "catch_clause"
                },
                {
                  "matches": "function-like"
                }
              ]
            },
            "boundary": {
              "any": [
                {
                  "matches": "scope"
                },
                {
                  "kind": "ambient_declaration"
                }
              ]
            },
            "destructuring": {
              "any": [
                {
                  "kind": "object_pattern"
                },
                {
                  "kind": "array_pattern"
                },
                {
                  "kind": "pair_pattern"
                },
                {
                  "kind": "object_assignment_pattern"
                },
                {
                  "kind": "assignment_pattern"
                },
                {
                  "kind": "rest_pattern"
                }
              ]
            },
            "local-import": {
              "not": {
                "has": {
                  "regex": "^type$"
                }
              },
              "inside": {
                "stopBy": "end",
                "kind": "import_statement",
                "has": {
                  "field": "source",
                  "regex": "^[\"']\\.\\.?/"
                },
                "not": {
                  "has": {
                    "regex": "^type$"
                  }
                }
              }
            },
            "not-a-default": {
              "not": {
                "inside": {
                  "field": "right",
                  "any": [
                    {
                      "kind": "assignment_pattern"
                    },
                    {
                      "kind": "object_assignment_pattern"
                    }
                  ]
                }
              }
            },
            "binding-slot": {
              "all": [
                {
                  "matches": "not-a-default"
                },
                {
                  "any": [
                    {
                      "inside": {
                        "stopBy": {
                          "not": {
                            "matches": "destructuring"
                          }
                        },
                        "field": "name",
                        "any": [
                          {
                            "kind": "variable_declarator"
                          },
                          {
                            "kind": "function_declaration"
                          },
                          {
                            "kind": "generator_function_declaration"
                          },
                          {
                            "kind": "function_expression"
                          },
                          {
                            "kind": "generator_function"
                          },
                          {
                            "kind": "class_declaration"
                          },
                          {
                            "kind": "abstract_class_declaration"
                          },
                          {
                            "kind": "enum_declaration",
                            "not": {
                              "has": {
                                "regex": "^const$"
                              }
                            }
                          }
                        ]
                      }
                    },
                    {
                      "inside": {
                        "stopBy": {
                          "not": {
                            "matches": "destructuring"
                          }
                        },
                        "field": "pattern",
                        "any": [
                          {
                            "kind": "required_parameter"
                          },
                          {
                            "kind": "optional_parameter"
                          }
                        ],
                        "inside": {
                          "kind": "formal_parameters",
                          "inside": {
                            "field": "parameters",
                            "matches": "function-like"
                          }
                        }
                      }
                    },
                    {
                      "inside": {
                        "stopBy": {
                          "not": {
                            "matches": "destructuring"
                          }
                        },
                        "field": "parameter",
                        "any": [
                          {
                            "kind": "arrow_function"
                          },
                          {
                            "kind": "catch_clause"
                          }
                        ]
                      }
                    },
                    {
                      "inside": {
                        "stopBy": {
                          "not": {
                            "matches": "destructuring"
                          }
                        },
                        "field": "left",
                        "kind": "for_in_statement",
                        "has": {
                          "field": "kind",
                          "regex": "^(const|let|var)$"
                        }
                      }
                    },
                    {
                      "inside": {
                        "field": "alias",
                        "kind": "import_specifier",
                        "matches": "local-import"
                      }
                    },
                    {
                      "inside": {
                        "field": "name",
                        "kind": "import_specifier",
                        "not": {
                          "has": {
                            "field": "alias",
                            "kind": "identifier"
                          }
                        },
                        "matches": "local-import"
                      }
                    },
                    {
                      "inside": {
                        "any": [
                          {
                            "kind": "import_clause"
                          },
                          {
                            "kind": "namespace_import"
                          }
                        ],
                        "matches": "local-import"
                      }
                    }
                  ]
                }
              ]
            },
            "declares": {
              "any": [
                {
                  "all": [
                    {
                      "any": [
                        {
                          "kind": "function_declaration"
                        },
                        {
                          "kind": "generator_function_declaration"
                        }
                      ]
                    },
                    {
                      "has": {
                        "field": "name",
                        "pattern": "$G"
                      }
                    }
                  ]
                },
                {
                  "all": [
                    {
                      "any": [
                        {
                          "kind": "identifier"
                        },
                        {
                          "kind": "type_identifier"
                        },
                        {
                          "kind": "shorthand_property_identifier_pattern"
                        }
                      ]
                    },
                    {
                      "pattern": "$G"
                    },
                    {
                      "matches": "binding-slot"
                    }
                  ]
                }
              ]
            },
            "not-the-global": {
              "any": [
                {
                  "kind": "identifier",
                  "inside": {
                    "field": "name",
                    "kind": "import_specifier",
                    "has": {
                      "field": "alias",
                      "kind": "identifier"
                    },
                    "matches": "local-import"
                  }
                },
                {
                  "kind": "identifier",
                  "matches": "not-a-default",
                  "inside": {
                    "stopBy": {
                      "not": {
                        "matches": "destructuring"
                      }
                    },
                    "field": "pattern",
                    "any": [
                      {
                        "kind": "required_parameter"
                      },
                      {
                        "kind": "optional_parameter"
                      }
                    ]
                  }
                },
                {
                  "all": [
                    {
                      "any": [
                        {
                          "kind": "identifier"
                        },
                        {
                          "kind": "shorthand_property_identifier"
                        }
                      ]
                    },
                    {
                      "pattern": "$G"
                    },
                    {
                      "inside": {
                        "stopBy": "end",
                        "matches": "scope",
                        "has": {
                          "stopBy": {
                            "matches": "boundary"
                          },
                          "matches": "declares"
                        }
                      }
                    }
                  ]
                }
              ]
            },
            "factory": {
              "any": [
                {
                  "matches": "inline-factory"
                },
                {
                  "matches": "named-creator"
                },
                {
                  "matches": "declared-creator"
                }
              ]
            },
            "inline-factory": {
              "any": [
                {
                  "kind": "arrow_function"
                },
                {
                  "kind": "function_expression"
                }
              ],
              "all": [
                {
                  "nthChild": {
                    "position": 1,
                    "ofRule": {
                      "not": {
                        "kind": "comment"
                      }
                    }
                  }
                },
                {
                  "inside": {
                    "any": [
                      {
                        "matches": "factory-arguments"
                      },
                      {
                        "matches": "factory-wrapper"
                      }
                    ]
                  }
                }
              ]
            },
            "ownership-scope": {
              "any": [
                {
                  "kind": "program"
                },
                {
                  "kind": "statement_block"
                },
                {
                  "kind": "switch_body"
                },
                {
                  "kind": "for_statement"
                },
                {
                  "kind": "for_in_statement"
                },
                {
                  "kind": "catch_clause"
                },
                {
                  "kind": "function_declaration"
                },
                {
                  "kind": "function_expression"
                },
                {
                  "kind": "arrow_function"
                },
                {
                  "kind": "generator_function"
                },
                {
                  "kind": "generator_function_declaration"
                },
                {
                  "kind": "method_definition"
                },
                {
                  "kind": "with_statement"
                }
              ]
            },
            "named-first-argument": {
              "all": [
                {
                  "kind": "identifier",
                  "pattern": "$CREATOR"
                },
                {
                  "nthChild": {
                    "position": 1,
                    "ofRule": {
                      "not": {
                        "kind": "comment"
                      }
                    }
                  }
                },
                {
                  "inside": {
                    "any": [
                      {
                        "matches": "factory-arguments"
                      },
                      {
                        "matches": "factory-wrapper"
                      }
                    ]
                  }
                }
              ]
            },
            "named-creator": {
              "all": [
                {
                  "any": [
                    {
                      "kind": "arrow_function"
                    },
                    {
                      "kind": "function_expression"
                    }
                  ]
                },
                {
                  "inside": {
                    "field": "value",
                    "stopBy": {
                      "not": {
                        "any": [
                          {
                            "kind": "parenthesized_expression"
                          },
                          {
                            "kind": "as_expression"
                          },
                          {
                            "kind": "satisfies_expression"
                          },
                          {
                            "kind": "non_null_expression"
                          }
                        ]
                      }
                    },
                    "kind": "variable_declarator",
                    "all": [
                      {
                        "has": {
                          "field": "name",
                          "kind": "identifier",
                          "pattern": "$CREATOR"
                        }
                      },
                      {
                        "any": [
                          {
                            "precedes": {
                              "stopBy": "end",
                              "has": {
                                "stopBy": {
                                  "matches": "ownership-scope"
                                },
                                "matches": "factory-reference"
                              }
                            }
                          },
                          {
                            "inside": {
                              "kind": "lexical_declaration",
                              "has": {
                                "regex": "^const$"
                              },
                              "precedes": {
                                "stopBy": "end",
                                "has": {
                                  "stopBy": {
                                    "matches": "ownership-scope"
                                  },
                                  "matches": "factory-reference"
                                }
                              }
                            }
                          },
                          {
                            "inside": {
                              "kind": "lexical_declaration",
                              "has": {
                                "regex": "^const$"
                              },
                              "inside": {
                                "field": "declaration",
                                "kind": "export_statement",
                                "precedes": {
                                  "stopBy": "end",
                                  "has": {
                                    "stopBy": {
                                      "matches": "ownership-scope"
                                    },
                                    "matches": "factory-reference"
                                  }
                                }
                              }
                            }
                          }
                        ]
                      }
                    ],
                    "inside": {
                      "kind": "lexical_declaration",
                      "has": {
                        "regex": "^const$"
                      }
                    }
                  }
                },
                {
                  "inside": {
                    "stopBy": {
                      "matches": "ownership-scope"
                    },
                    "matches": "ownership-scope",
                    "has": {
                      "stopBy": {
                        "matches": "ownership-scope"
                      },
                      "matches": "factory-reference"
                    }
                  }
                }
              ]
            },
            "declared-creator": {
              "all": [
                {
                  "kind": "function_declaration"
                },
                {
                  "has": {
                    "field": "name",
                    "kind": "identifier",
                    "pattern": "$CREATOR"
                  }
                },
                {
                  "not": {
                    "any": [
                      {
                        "precedes": {
                          "stopBy": "end",
                          "any": [
                            {
                              "matches": "creator-declaration"
                            },
                            {
                              "has": {
                                "stopBy": {
                                  "matches": "ownership-scope"
                                },
                                "matches": "creator-declaration"
                              }
                            }
                          ]
                        }
                      },
                      {
                        "follows": {
                          "stopBy": "end",
                          "any": [
                            {
                              "matches": "creator-declaration"
                            },
                            {
                              "has": {
                                "stopBy": {
                                  "matches": "ownership-scope"
                                },
                                "matches": "creator-declaration"
                              }
                            }
                          ]
                        }
                      },
                      {
                        "inside": {
                          "kind": "export_statement",
                          "any": [
                            {
                              "precedes": {
                                "stopBy": "end",
                                "any": [
                                  {
                                    "matches": "creator-declaration"
                                  },
                                  {
                                    "has": {
                                      "stopBy": {
                                        "matches": "ownership-scope"
                                      },
                                      "matches": "creator-declaration"
                                    }
                                  }
                                ]
                              }
                            },
                            {
                              "follows": {
                                "stopBy": "end",
                                "any": [
                                  {
                                    "matches": "creator-declaration"
                                  },
                                  {
                                    "has": {
                                      "stopBy": {
                                        "matches": "ownership-scope"
                                      },
                                      "matches": "creator-declaration"
                                    }
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      }
                    ]
                  }
                },
                {
                  "inside": {
                    "stopBy": {
                      "matches": "ownership-scope"
                    },
                    "matches": "ownership-scope",
                    "all": [
                      {
                        "has": {
                          "stopBy": {
                            "matches": "ownership-scope"
                          },
                          "matches": "factory-reference"
                        }
                      },
                      {
                        "not": {
                          "has": {
                            "stopBy": "end",
                            "matches": "creator-rebinding"
                          }
                        }
                      }
                    ]
                  }
                }
              ]
            },
            "creator-declaration": {
              "kind": "function_declaration",
              "has": {
                "field": "name",
                "pattern": "$CREATOR"
              }
            },
            "creator-rebinding": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "assignment_expression"
                    },
                    {
                      "kind": "augmented_assignment_expression"
                    },
                    {
                      "kind": "for_in_statement"
                    }
                  ],
                  "has": {
                    "field": "left",
                    "matches": "creator-target"
                  }
                },
                {
                  "kind": "update_expression",
                  "has": {
                    "field": "argument",
                    "matches": "creator-target"
                  }
                },
                {
                  "kind": "variable_declarator",
                  "has": {
                    "field": "name",
                    "matches": "creator-target"
                  }
                }
              ]
            },
            "creator-target": {
              "any": [
                {
                  "pattern": "$CREATOR"
                },
                {
                  "has": {
                    "stopBy": "end",
                    "pattern": "$CREATOR"
                  }
                }
              ]
            },
            "creator-member": {
              "any": [
                {
                  "kind": "member_expression",
                  "all": [
                    {
                      "has": {
                        "field": "property",
                        "regex": "^(addFactoryMethod)$"
                      }
                    }
                  ]
                },
                {
                  "kind": "subscript_expression",
                  "all": [
                    {
                      "has": {
                        "field": "index",
                        "regex": "^[\\\"'`](addFactoryMethod)[\\\"'`]$"
                      }
                    }
                  ]
                },
                {
                  "any": [
                    {
                      "kind": "parenthesized_expression"
                    },
                    {
                      "kind": "as_expression"
                    },
                    {
                      "kind": "satisfies_expression"
                    },
                    {
                      "kind": "non_null_expression"
                    }
                  ],
                  "has": {
                    "nthChild": {
                      "position": 1,
                      "ofRule": {
                        "not": {
                          "kind": "comment"
                        }
                      }
                    },
                    "matches": "creator-member"
                  }
                }
              ]
            },
            "factory-arguments": {
              "kind": "arguments",
              "inside": {
                "kind": "call_expression",
                "has": {
                  "field": "function",
                  "matches": "creator-member"
                }
              }
            },
            "factory-wrapper": {
              "all": [
                {
                  "any": [
                    {
                      "kind": "parenthesized_expression"
                    },
                    {
                      "kind": "as_expression"
                    },
                    {
                      "kind": "satisfies_expression"
                    },
                    {
                      "kind": "non_null_expression"
                    }
                  ]
                },
                {
                  "nthChild": {
                    "position": 1,
                    "ofRule": {
                      "not": {
                        "kind": "comment"
                      }
                    }
                  }
                },
                {
                  "inside": {
                    "any": [
                      {
                        "matches": "factory-arguments"
                      },
                      {
                        "matches": "factory-wrapper"
                      }
                    ]
                  }
                }
              ]
            },
            "alias-first-argument": {
              "all": [
                {
                  "kind": "identifier",
                  "pattern": "$ALIAS"
                },
                {
                  "nthChild": {
                    "position": 1,
                    "ofRule": {
                      "not": {
                        "kind": "comment"
                      }
                    }
                  }
                },
                {
                  "inside": {
                    "any": [
                      {
                        "matches": "factory-arguments"
                      },
                      {
                        "matches": "factory-wrapper"
                      }
                    ]
                  }
                }
              ]
            },
            "alias-source-reference": {
              "all": [
                {
                  "kind": "identifier",
                  "pattern": "$CREATOR"
                },
                {
                  "inside": {
                    "field": "value",
                    "stopBy": {
                      "not": {
                        "any": [
                          {
                            "kind": "parenthesized_expression"
                          },
                          {
                            "kind": "as_expression"
                          },
                          {
                            "kind": "satisfies_expression"
                          },
                          {
                            "kind": "non_null_expression"
                          }
                        ]
                      }
                    },
                    "kind": "variable_declarator",
                    "all": [
                      {
                        "has": {
                          "field": "name",
                          "kind": "identifier",
                          "pattern": "$ALIAS"
                        }
                      },
                      {
                        "any": [
                          {
                            "precedes": {
                              "stopBy": "end",
                              "has": {
                                "stopBy": {
                                  "matches": "ownership-scope"
                                },
                                "matches": "alias-first-argument"
                              }
                            }
                          },
                          {
                            "inside": {
                              "kind": "lexical_declaration",
                              "has": {
                                "regex": "^const$"
                              },
                              "precedes": {
                                "stopBy": "end",
                                "has": {
                                  "stopBy": {
                                    "matches": "ownership-scope"
                                  },
                                  "matches": "alias-first-argument"
                                }
                              }
                            }
                          },
                          {
                            "inside": {
                              "kind": "lexical_declaration",
                              "has": {
                                "regex": "^const$"
                              },
                              "inside": {
                                "field": "declaration",
                                "kind": "export_statement",
                                "precedes": {
                                  "stopBy": "end",
                                  "has": {
                                    "stopBy": {
                                      "matches": "ownership-scope"
                                    },
                                    "matches": "alias-first-argument"
                                  }
                                }
                              }
                            }
                          }
                        ]
                      }
                    ],
                    "inside": {
                      "kind": "lexical_declaration",
                      "has": {
                        "regex": "^const$"
                      }
                    }
                  }
                },
                {
                  "inside": {
                    "stopBy": {
                      "matches": "ownership-scope"
                    },
                    "matches": "ownership-scope",
                    "has": {
                      "stopBy": {
                        "matches": "ownership-scope"
                      },
                      "matches": "alias-first-argument"
                    }
                  }
                }
              ]
            },
            "factory-reference": {
              "any": [
                {
                  "matches": "named-first-argument"
                },
                {
                  "matches": "alias-source-reference"
                }
              ]
            }
          },
          "rule": {
            "all": [
              {
                "any": [
                  {
                    "any": [
                      {
                        "kind": "identifier"
                      },
                      {
                        "kind": "shorthand_property_identifier"
                      }
                    ],
                    "regex": "^(Date|Temporal|process|Bun|Deno|performance|fetch|console|window|document|localStorage|sessionStorage|WebSocket|randomUUID|getRandomValues|randomBytes|randomInt|randomFill|randomFillSync)$",
                    "not": {
                      "inside": {
                        "kind": "nested_type_identifier"
                      }
                    }
                  },
                  {
                    "any": [
                      {
                        "kind": "identifier",
                        "regex": "^(Math|crypto|globalThis|window|global|self)$"
                      },
                      {
                        "kind": "meta_property"
                      }
                    ],
                    "not": {
                      "inside": {
                        "field": "object",
                        "kind": "member_expression",
                        "has": {
                          "field": "property",
                          "not": {
                            "regex": "^(random|randomUUID|getRandomValues|randomBytes|randomInt|randomFill|randomFillSync|Date|Temporal|process|Bun|Deno|performance|fetch|console|document|localStorage|sessionStorage|WebSocket|env|Math|crypto|globalThis|window|global|self)$"
                          }
                        }
                      }
                    }
                  }
                ]
              },
              {
                "not": {
                  "matches": "not-the-global"
                }
              },
              {
                "not": {
                  "inside": {
                    "kind": "type_query",
                    "stopBy": "end"
                  }
                }
              },
              {
                "inside": {
                  "stopBy": "end",
                  "matches": "factory"
                }
              }
            ]
          },
          "x-note": "Project policy over selected managed paths. Uses lexical scope predicates from PREGATE effect rules. Relative imports and local bindings are distinguished; aliases and global-object traversal are covered. Hoisted var bindings in nested blocks remain a conservative limitation. Qualified allow entries are explicit project exceptions."
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "An admission factory must use injected dependencies instead of ambient effects."
  }
}
