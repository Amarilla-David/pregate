{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "dcouplr/factories/no-uninjected-required-parameter",
  "version": "1.4.0",
  "area": "factories",
  "cardinality": "singleton",
  "dimension": "dcouplr.factory-injected-arguments",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "required-after-input-and-kernel",
          "utils": {
            "runtime-parameter": {
              "any": [
                {
                  "kind": "required_parameter"
                },
                {
                  "kind": "optional_parameter"
                }
              ],
              "not": {
                "has": {
                  "field": "pattern",
                  "regex": "^this$"
                }
              }
            },
            "factory": {
              "any": [
                {
                  "matches": "inline-factory"
                },
                {
                  "matches": "named-creator"
                },
                {
                  "matches": "declared-creator"
                }
              ]
            },
            "inline-factory": {
              "any": [
                {
                  "kind": "arrow_function"
                },
                {
                  "kind": "function_expression"
                }
              ],
              "all": [
                {
                  "nthChild": {
                    "position": 1,
                    "ofRule": {
                      "not": {
                        "kind": "comment"
                      }
                    }
                  }
                },
                {
                  "inside": {
                    "any": [
                      {
                        "matches": "factory-arguments"
                      },
                      {
                        "matches": "factory-wrapper"
                      }
                    ]
                  }
                }
              ]
            },
            "ownership-scope": {
              "any": [
                {
                  "kind": "program"
                },
                {
                  "kind": "statement_block"
                },
                {
                  "kind": "switch_body"
                },
                {
                  "kind": "for_statement"
                },
                {
                  "kind": "for_in_statement"
                },
                {
                  "kind": "catch_clause"
                },
                {
                  "kind": "function_declaration"
                },
                {
                  "kind": "function_expression"
                },
                {
                  "kind": "arrow_function"
                },
                {
                  "kind": "generator_function"
                },
                {
                  "kind": "generator_function_declaration"
                },
                {
                  "kind": "method_definition"
                },
                {
                  "kind": "with_statement"
                }
              ]
            },
            "named-first-argument": {
              "all": [
                {
                  "kind": "identifier",
                  "pattern": "$CREATOR"
                },
                {
                  "nthChild": {
                    "position": 1,
                    "ofRule": {
                      "not": {
                        "kind": "comment"
                      }
                    }
                  }
                },
                {
                  "inside": {
                    "any": [
                      {
                        "matches": "factory-arguments"
                      },
                      {
                        "matches": "factory-wrapper"
                      }
                    ]
                  }
                }
              ]
            },
            "named-creator": {
              "all": [
                {
                  "any": [
                    {
                      "kind": "arrow_function"
                    },
                    {
                      "kind": "function_expression"
                    }
                  ]
                },
                {
                  "inside": {
                    "field": "value",
                    "stopBy": {
                      "not": {
                        "any": [
                          {
                            "kind": "parenthesized_expression"
                          },
                          {
                            "kind": "as_expression"
                          },
                          {
                            "kind": "satisfies_expression"
                          },
                          {
                            "kind": "non_null_expression"
                          }
                        ]
                      }
                    },
                    "kind": "variable_declarator",
                    "all": [
                      {
                        "has": {
                          "field": "name",
                          "kind": "identifier",
                          "pattern": "$CREATOR"
                        }
                      },
                      {
                        "any": [
                          {
                            "precedes": {
                              "stopBy": "end",
                              "has": {
                                "stopBy": {
                                  "matches": "ownership-scope"
                                },
                                "matches": "factory-reference"
                              }
                            }
                          },
                          {
                            "inside": {
                              "kind": "lexical_declaration",
                              "has": {
                                "regex": "^const$"
                              },
                              "precedes": {
                                "stopBy": "end",
                                "has": {
                                  "stopBy": {
                                    "matches": "ownership-scope"
                                  },
                                  "matches": "factory-reference"
                                }
                              }
                            }
                          },
                          {
                            "inside": {
                              "kind": "lexical_declaration",
                              "has": {
                                "regex": "^const$"
                              },
                              "inside": {
                                "field": "declaration",
                                "kind": "export_statement",
                                "precedes": {
                                  "stopBy": "end",
                                  "has": {
                                    "stopBy": {
                                      "matches": "ownership-scope"
                                    },
                                    "matches": "factory-reference"
                                  }
                                }
                              }
                            }
                          }
                        ]
                      }
                    ],
                    "inside": {
                      "kind": "lexical_declaration",
                      "has": {
                        "regex": "^const$"
                      }
                    }
                  }
                },
                {
                  "inside": {
                    "stopBy": {
                      "matches": "ownership-scope"
                    },
                    "matches": "ownership-scope",
                    "has": {
                      "stopBy": {
                        "matches": "ownership-scope"
                      },
                      "matches": "factory-reference"
                    }
                  }
                }
              ]
            },
            "declared-creator": {
              "all": [
                {
                  "kind": "function_declaration"
                },
                {
                  "has": {
                    "field": "name",
                    "kind": "identifier",
                    "pattern": "$CREATOR"
                  }
                },
                {
                  "not": {
                    "any": [
                      {
                        "precedes": {
                          "stopBy": "end",
                          "any": [
                            {
                              "matches": "creator-declaration"
                            },
                            {
                              "has": {
                                "stopBy": {
                                  "matches": "ownership-scope"
                                },
                                "matches": "creator-declaration"
                              }
                            }
                          ]
                        }
                      },
                      {
                        "follows": {
                          "stopBy": "end",
                          "any": [
                            {
                              "matches": "creator-declaration"
                            },
                            {
                              "has": {
                                "stopBy": {
                                  "matches": "ownership-scope"
                                },
                                "matches": "creator-declaration"
                              }
                            }
                          ]
                        }
                      },
                      {
                        "inside": {
                          "kind": "export_statement",
                          "any": [
                            {
                              "precedes": {
                                "stopBy": "end",
                                "any": [
                                  {
                                    "matches": "creator-declaration"
                                  },
                                  {
                                    "has": {
                                      "stopBy": {
                                        "matches": "ownership-scope"
                                      },
                                      "matches": "creator-declaration"
                                    }
                                  }
                                ]
                              }
                            },
                            {
                              "follows": {
                                "stopBy": "end",
                                "any": [
                                  {
                                    "matches": "creator-declaration"
                                  },
                                  {
                                    "has": {
                                      "stopBy": {
                                        "matches": "ownership-scope"
                                      },
                                      "matches": "creator-declaration"
                                    }
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      }
                    ]
                  }
                },
                {
                  "inside": {
                    "stopBy": {
                      "matches": "ownership-scope"
                    },
                    "matches": "ownership-scope",
                    "all": [
                      {
                        "has": {
                          "stopBy": {
                            "matches": "ownership-scope"
                          },
                          "matches": "factory-reference"
                        }
                      },
                      {
                        "not": {
                          "has": {
                            "stopBy": "end",
                            "matches": "creator-rebinding"
                          }
                        }
                      }
                    ]
                  }
                }
              ]
            },
            "creator-declaration": {
              "kind": "function_declaration",
              "has": {
                "field": "name",
                "pattern": "$CREATOR"
              }
            },
            "creator-rebinding": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "assignment_expression"
                    },
                    {
                      "kind": "augmented_assignment_expression"
                    },
                    {
                      "kind": "for_in_statement"
                    }
                  ],
                  "has": {
                    "field": "left",
                    "matches": "creator-target"
                  }
                },
                {
                  "kind": "update_expression",
                  "has": {
                    "field": "argument",
                    "matches": "creator-target"
                  }
                },
                {
                  "kind": "variable_declarator",
                  "has": {
                    "field": "name",
                    "matches": "creator-target"
                  }
                }
              ]
            },
            "creator-target": {
              "any": [
                {
                  "pattern": "$CREATOR"
                },
                {
                  "has": {
                    "stopBy": "end",
                    "pattern": "$CREATOR"
                  }
                }
              ]
            },
            "creator-member": {
              "any": [
                {
                  "kind": "member_expression",
                  "all": [
                    {
                      "has": {
                        "field": "property",
                        "regex": "^(addFactoryMethod)$"
                      }
                    }
                  ]
                },
                {
                  "kind": "subscript_expression",
                  "all": [
                    {
                      "has": {
                        "field": "index",
                        "regex": "^[\\\"'`](addFactoryMethod)[\\\"'`]$"
                      }
                    }
                  ]
                },
                {
                  "any": [
                    {
                      "kind": "parenthesized_expression"
                    },
                    {
                      "kind": "as_expression"
                    },
                    {
                      "kind": "satisfies_expression"
                    },
                    {
                      "kind": "non_null_expression"
                    }
                  ],
                  "has": {
                    "nthChild": {
                      "position": 1,
                      "ofRule": {
                        "not": {
                          "kind": "comment"
                        }
                      }
                    },
                    "matches": "creator-member"
                  }
                }
              ]
            },
            "factory-arguments": {
              "kind": "arguments",
              "inside": {
                "kind": "call_expression",
                "has": {
                  "field": "function",
                  "matches": "creator-member"
                }
              }
            },
            "factory-wrapper": {
              "all": [
                {
                  "any": [
                    {
                      "kind": "parenthesized_expression"
                    },
                    {
                      "kind": "as_expression"
                    },
                    {
                      "kind": "satisfies_expression"
                    },
                    {
                      "kind": "non_null_expression"
                    }
                  ]
                },
                {
                  "nthChild": {
                    "position": 1,
                    "ofRule": {
                      "not": {
                        "kind": "comment"
                      }
                    }
                  }
                },
                {
                  "inside": {
                    "any": [
                      {
                        "matches": "factory-arguments"
                      },
                      {
                        "matches": "factory-wrapper"
                      }
                    ]
                  }
                }
              ]
            },
            "alias-first-argument": {
              "all": [
                {
                  "kind": "identifier",
                  "pattern": "$ALIAS"
                },
                {
                  "nthChild": {
                    "position": 1,
                    "ofRule": {
                      "not": {
                        "kind": "comment"
                      }
                    }
                  }
                },
                {
                  "inside": {
                    "any": [
                      {
                        "matches": "factory-arguments"
                      },
                      {
                        "matches": "factory-wrapper"
                      }
                    ]
                  }
                }
              ]
            },
            "alias-source-reference": {
              "all": [
                {
                  "kind": "identifier",
                  "pattern": "$CREATOR"
                },
                {
                  "inside": {
                    "field": "value",
                    "stopBy": {
                      "not": {
                        "any": [
                          {
                            "kind": "parenthesized_expression"
                          },
                          {
                            "kind": "as_expression"
                          },
                          {
                            "kind": "satisfies_expression"
                          },
                          {
                            "kind": "non_null_expression"
                          }
                        ]
                      }
                    },
                    "kind": "variable_declarator",
                    "all": [
                      {
                        "has": {
                          "field": "name",
                          "kind": "identifier",
                          "pattern": "$ALIAS"
                        }
                      },
                      {
                        "any": [
                          {
                            "precedes": {
                              "stopBy": "end",
                              "has": {
                                "stopBy": {
                                  "matches": "ownership-scope"
                                },
                                "matches": "alias-first-argument"
                              }
                            }
                          },
                          {
                            "inside": {
                              "kind": "lexical_declaration",
                              "has": {
                                "regex": "^const$"
                              },
                              "precedes": {
                                "stopBy": "end",
                                "has": {
                                  "stopBy": {
                                    "matches": "ownership-scope"
                                  },
                                  "matches": "alias-first-argument"
                                }
                              }
                            }
                          },
                          {
                            "inside": {
                              "kind": "lexical_declaration",
                              "has": {
                                "regex": "^const$"
                              },
                              "inside": {
                                "field": "declaration",
                                "kind": "export_statement",
                                "precedes": {
                                  "stopBy": "end",
                                  "has": {
                                    "stopBy": {
                                      "matches": "ownership-scope"
                                    },
                                    "matches": "alias-first-argument"
                                  }
                                }
                              }
                            }
                          }
                        ]
                      }
                    ],
                    "inside": {
                      "kind": "lexical_declaration",
                      "has": {
                        "regex": "^const$"
                      }
                    }
                  }
                },
                {
                  "inside": {
                    "stopBy": {
                      "matches": "ownership-scope"
                    },
                    "matches": "ownership-scope",
                    "has": {
                      "stopBy": {
                        "matches": "ownership-scope"
                      },
                      "matches": "alias-first-argument"
                    }
                  }
                }
              ]
            },
            "factory-reference": {
              "any": [
                {
                  "matches": "named-first-argument"
                },
                {
                  "matches": "alias-source-reference"
                }
              ]
            }
          },
          "rule": {
            "all": [
              {
                "kind": "required_parameter"
              },
              {
                "matches": "runtime-parameter"
              },
              {
                "not": {
                  "has": {
                    "field": "value",
                    "regex": ".+"
                  }
                }
              },
              {
                "not": {
                  "has": {
                    "field": "pattern",
                    "kind": "rest_pattern"
                  }
                }
              },
              {
                "not": {
                  "any": [
                    {
                      "nthChild": {
                        "position": 1,
                        "ofRule": {
                          "matches": "runtime-parameter"
                        }
                      }
                    },
                    {
                      "nthChild": {
                        "position": 2,
                        "ofRule": {
                          "matches": "runtime-parameter"
                        }
                      }
                    }
                  ]
                }
              },
              {
                "inside": {
                  "kind": "formal_parameters",
                  "inside": {
                    "matches": "factory"
                  }
                }
              }
            ]
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "dcouplr injects only inputDto and dKernel. A later required factory argument always receives undefined."
  }
}
