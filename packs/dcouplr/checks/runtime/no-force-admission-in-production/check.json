{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "dcouplr/runtime/no-force-admission-in-production",
  "version": "1.0.0",
  "area": "runtime",
  "cardinality": "singleton",
  "dimension": "dcouplr.production-force-admission",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [{
        "id": "test-only-admission-call",
        "rule": {
          "kind": "call_expression",
          "has": {
            "field": "function",
            "any": [
              { "kind": "member_expression", "has": { "field": "property", "regex": "^register(?:Singleton)?Force$" } },
              { "kind": "subscript_expression", "has": { "field": "index", "regex": "^[\"'`]register(?:Singleton)?Force[\"'`]$" } }
            ]
          }
        }
      }]
    }
  },
  "phase": ["pre", "stop", "commit", "ci"],
  "feedback": { "message": "Force admission calls are test-only in the selected production scope. Use register or registerSingleton and keep replacements in test modules." }
}
