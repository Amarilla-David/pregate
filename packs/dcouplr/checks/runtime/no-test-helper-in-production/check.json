{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "dcouplr/runtime/no-test-helper-in-production",
  "version": "1.0.0",
  "area": "runtime",
  "cardinality": "singleton",
  "dimension": "dcouplr.no-test-helper-in-production",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "test-helper-import",
          "rule": {
            "kind": "import_specifier",
            "has": {
              "field": "name",
              "regex": "^(getDcouplrForTesting|resetDcouplrForTesting)$"
            },
            "inside": {
              "stopBy": "end",
              "kind": "import_statement",
              "has": {
                "field": "source",
                "regex": "^[\"']dcouplr[\"']$"
              },
              "not": {
                "has": {
                  "regex": "^type$"
                }
              }
            },
            "not": {
              "has": {
                "regex": "^type$"
              }
            }
          }
        },
        {
          "id": "namespace-test-helper",
          "utils": {
            "function-like": {
              "any": [
                {
                  "kind": "function_declaration"
                },
                {
                  "kind": "generator_function_declaration"
                },
                {
                  "kind": "function_expression"
                },
                {
                  "kind": "generator_function"
                },
                {
                  "kind": "arrow_function"
                },
                {
                  "kind": "method_definition"
                }
              ]
            },
            "scope": {
              "any": [
                {
                  "kind": "program"
                },
                {
                  "kind": "statement_block"
                },
                {
                  "kind": "switch_body"
                },
                {
                  "kind": "for_statement"
                },
                {
                  "kind": "for_in_statement"
                },
                {
                  "kind": "catch_clause"
                },
                {
                  "matches": "function-like"
                }
              ]
            },
            "boundary": {
              "any": [
                {
                  "matches": "scope"
                },
                {
                  "kind": "ambient_declaration"
                }
              ]
            },
            "destructuring": {
              "any": [
                {
                  "kind": "object_pattern"
                },
                {
                  "kind": "array_pattern"
                },
                {
                  "kind": "pair_pattern"
                },
                {
                  "kind": "object_assignment_pattern"
                },
                {
                  "kind": "assignment_pattern"
                },
                {
                  "kind": "rest_pattern"
                }
              ]
            },
            "local-import": {
              "not": {
                "has": {
                  "regex": "^type$"
                }
              },
              "inside": {
                "stopBy": "end",
                "kind": "import_statement",
                "has": {
                  "field": "source",
                  "regex": "^[\"']\\.\\.?/"
                },
                "not": {
                  "has": {
                    "regex": "^type$"
                  }
                }
              }
            },
            "not-a-default": {
              "not": {
                "inside": {
                  "field": "right",
                  "any": [
                    {
                      "kind": "assignment_pattern"
                    },
                    {
                      "kind": "object_assignment_pattern"
                    }
                  ]
                }
              }
            },
            "binding-slot": {
              "all": [
                {
                  "matches": "not-a-default"
                },
                {
                  "any": [
                    {
                      "inside": {
                        "stopBy": {
                          "not": {
                            "matches": "destructuring"
                          }
                        },
                        "field": "name",
                        "any": [
                          {
                            "kind": "variable_declarator"
                          },
                          {
                            "kind": "function_declaration"
                          },
                          {
                            "kind": "generator_function_declaration"
                          },
                          {
                            "kind": "function_expression"
                          },
                          {
                            "kind": "generator_function"
                          },
                          {
                            "kind": "class_declaration"
                          },
                          {
                            "kind": "abstract_class_declaration"
                          },
                          {
                            "kind": "enum_declaration",
                            "not": {
                              "has": {
                                "regex": "^const$"
                              }
                            }
                          }
                        ]
                      }
                    },
                    {
                      "inside": {
                        "stopBy": {
                          "not": {
                            "matches": "destructuring"
                          }
                        },
                        "field": "pattern",
                        "any": [
                          {
                            "kind": "required_parameter"
                          },
                          {
                            "kind": "optional_parameter"
                          }
                        ],
                        "inside": {
                          "kind": "formal_parameters",
                          "inside": {
                            "field": "parameters",
                            "matches": "function-like"
                          }
                        }
                      }
                    },
                    {
                      "inside": {
                        "stopBy": {
                          "not": {
                            "matches": "destructuring"
                          }
                        },
                        "field": "parameter",
                        "any": [
                          {
                            "kind": "arrow_function"
                          },
                          {
                            "kind": "catch_clause"
                          }
                        ]
                      }
                    },
                    {
                      "inside": {
                        "stopBy": {
                          "not": {
                            "matches": "destructuring"
                          }
                        },
                        "field": "left",
                        "kind": "for_in_statement",
                        "has": {
                          "field": "kind",
                          "regex": "^(const|let|var)$"
                        }
                      }
                    },
                    {
                      "inside": {
                        "field": "alias",
                        "kind": "import_specifier",
                        "matches": "local-import"
                      }
                    },
                    {
                      "inside": {
                        "field": "name",
                        "kind": "import_specifier",
                        "not": {
                          "has": {
                            "field": "alias",
                            "kind": "identifier"
                          }
                        },
                        "matches": "local-import"
                      }
                    },
                    {
                      "inside": {
                        "any": [
                          {
                            "kind": "import_clause"
                          },
                          {
                            "kind": "namespace_import"
                          }
                        ],
                        "matches": "local-import"
                      }
                    }
                  ]
                }
              ]
            },
            "declares": {
              "any": [
                {
                  "all": [
                    {
                      "any": [
                        {
                          "kind": "function_declaration"
                        },
                        {
                          "kind": "generator_function_declaration"
                        }
                      ]
                    },
                    {
                      "has": {
                        "field": "name",
                        "pattern": "$G"
                      }
                    }
                  ]
                },
                {
                  "all": [
                    {
                      "any": [
                        {
                          "kind": "identifier"
                        },
                        {
                          "kind": "type_identifier"
                        },
                        {
                          "kind": "shorthand_property_identifier_pattern"
                        }
                      ]
                    },
                    {
                      "pattern": "$G"
                    },
                    {
                      "matches": "binding-slot"
                    }
                  ]
                }
              ]
            },
            "not-the-global": {
              "any": [
                {
                  "kind": "identifier",
                  "inside": {
                    "field": "name",
                    "kind": "import_specifier",
                    "has": {
                      "field": "alias",
                      "kind": "identifier"
                    },
                    "matches": "local-import"
                  }
                },
                {
                  "kind": "identifier",
                  "matches": "not-a-default",
                  "inside": {
                    "stopBy": {
                      "not": {
                        "matches": "destructuring"
                      }
                    },
                    "field": "pattern",
                    "any": [
                      {
                        "kind": "required_parameter"
                      },
                      {
                        "kind": "optional_parameter"
                      }
                    ]
                  }
                },
                {
                  "all": [
                    {
                      "any": [
                        {
                          "kind": "identifier"
                        },
                        {
                          "kind": "shorthand_property_identifier"
                        }
                      ]
                    },
                    {
                      "pattern": "$G"
                    },
                    {
                      "inside": {
                        "stopBy": "end",
                        "matches": "scope",
                        "has": {
                          "stopBy": {
                            "matches": "boundary"
                          },
                          "matches": "declares"
                        }
                      }
                    }
                  ]
                }
              ]
            }
          },
          "rule": {
            "all": [
              {
                "kind": "identifier",
                "pattern": "$G"
              },
              {
                "any": [
                  {
                    "inside": {
                      "field": "object",
                      "kind": "member_expression",
                      "has": {
                        "field": "property",
                        "regex": "^(getDcouplrForTesting|resetDcouplrForTesting)$"
                      }
                    }
                  },
                  {
                    "inside": {
                      "field": "object",
                      "kind": "subscript_expression",
                      "has": {
                        "field": "index",
                        "kind": "string",
                        "regex": "^[\"'](getDcouplrForTesting|resetDcouplrForTesting)[\"']$"
                      }
                    }
                  },
                  {
                    "inside": {
                      "field": "value",
                      "kind": "variable_declarator",
                      "has": {
                        "field": "name",
                        "kind": "object_pattern",
                        "has": {
                          "stopBy": "end",
                          "any": [
                            {
                              "kind": "shorthand_property_identifier_pattern",
                              "regex": "^(getDcouplrForTesting|resetDcouplrForTesting)$"
                            },
                            {
                              "kind": "pair_pattern",
                              "has": {
                                "field": "key",
                                "regex": "^(getDcouplrForTesting|resetDcouplrForTesting)$"
                              }
                            }
                          ]
                        }
                      }
                    }
                  }
                ]
              },
              {
                "not": {
                  "matches": "not-the-global"
                }
              },
              {
                "inside": {
                  "stopBy": "end",
                  "kind": "program",
                  "has": {
                    "stopBy": "end",
                    "kind": "import_statement",
                    "not": {
                      "has": {
                        "regex": "^type$"
                      }
                    },
                    "all": [
                      {
                        "has": {
                          "field": "source",
                          "regex": "^[\"']dcouplr[\"']$"
                        }
                      },
                      {
                        "has": {
                          "stopBy": "end",
                          "kind": "namespace_import",
                          "has": {
                            "kind": "identifier",
                            "pattern": "$G"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            ]
          },
          "x-note": "Direct value namespace imports, static dot/bracket members and object destructuring. Lexical bindings distinguish shadowed names. Namespace alias data flow, computed names, dynamic/CommonJS imports and re-export barrels require separate coverage."
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "Production code must not import dcouplr test reset or test runtime helpers."
  }
}
