{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "dcouplr/runtime/immutable-system-settings",
  "version": "1.0.0",
  "area": "runtime",
  "cardinality": "singleton",
  "dimension": "dcouplr.bootstrap-setting-ownership",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "immutable-system-settings",
          "rule": {
            "kind": "call_expression",
            "all": [
              {
                "has": {
                  "field": "function",
                  "matches": "settings-setter"
                }
              },
              {
                "has": {
                  "field": "arguments",
                  "has": {
                    "nthChild": {
                      "position": 1,
                      "ofRule": {
                        "not": {
                          "kind": "comment"
                        }
                      }
                    },
                    "matches": "system-key"
                  }
                }
              }
            ]
          },
          "utils": {
            "settings-object": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "member_expression",
                      "has": {
                        "field": "property",
                        "regex": "^settings$"
                      }
                    },
                    {
                      "kind": "subscript_expression",
                      "has": {
                        "field": "index",
                        "regex": "^[\"'`]settings[\"'`]$"
                      }
                    }
                  ]
                },
                {
                  "any": [
                    {
                      "kind": "parenthesized_expression"
                    },
                    {
                      "kind": "as_expression"
                    },
                    {
                      "kind": "satisfies_expression"
                    },
                    {
                      "kind": "non_null_expression"
                    }
                  ],
                  "has": {
                    "nthChild": {
                      "position": 1,
                      "ofRule": {
                        "not": {
                          "kind": "comment"
                        }
                      }
                    },
                    "matches": "settings-object"
                  }
                }
              ]
            },
            "settings-setter": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "member_expression",
                      "has": {
                        "field": "property",
                        "regex": "^setSetting$"
                      }
                    },
                    {
                      "kind": "subscript_expression",
                      "has": {
                        "field": "index",
                        "regex": "^[\"'`]setSetting[\"'`]$"
                      }
                    }
                  ],
                  "has": {
                    "field": "object",
                    "matches": "settings-object"
                  }
                },
                {
                  "any": [
                    {
                      "kind": "parenthesized_expression"
                    },
                    {
                      "kind": "as_expression"
                    },
                    {
                      "kind": "satisfies_expression"
                    },
                    {
                      "kind": "non_null_expression"
                    }
                  ],
                  "has": {
                    "nthChild": {
                      "position": 1,
                      "ofRule": {
                        "not": {
                          "kind": "comment"
                        }
                      }
                    },
                    "matches": "settings-setter"
                  }
                }
              ]
            },
            "system-key": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "string"
                    },
                    {
                      "kind": "template_string"
                    }
                  ],
                  "regex": "^[\"'`](?:charEncoding|mode|ephemeral|forbiddenElements|instanceId)[\"'`]$"
                },
                {
                  "any": [
                    {
                      "kind": "parenthesized_expression"
                    },
                    {
                      "kind": "as_expression"
                    },
                    {
                      "kind": "satisfies_expression"
                    },
                    {
                      "kind": "non_null_expression"
                    }
                  ],
                  "has": {
                    "nthChild": {
                      "position": 1,
                      "ofRule": {
                        "not": {
                          "kind": "comment"
                        }
                      }
                    },
                    "matches": "system-key"
                  }
                }
              ]
            }
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "System settings are bootstrap-owned. Configure them once in setupDcouplr instead of overwriting them with settings.setSetting."
  }
}
