{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "dcouplr/boundaries/no-direct-construction",
  "version": "1.3.0",
  "area": "boundaries",
  "cardinality": "singleton",
  "dimension": "dcouplr.no-direct-construction",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "managed-new",
          "utils": {
            "factory": {
              "any": [
                {
                  "matches": "inline-factory"
                },
                {
                  "matches": "named-root"
                }
              ]
            },
            "inline-factory": {
              "any": [
                {
                  "kind": "arrow_function"
                },
                {
                  "kind": "function_expression"
                }
              ],
              "all": [
                {
                  "nthChild": {
                    "position": 1,
                    "ofRule": {
                      "not": {
                        "kind": "comment"
                      }
                    }
                  }
                },
                {
                  "inside": {
                    "any": [
                      {
                        "matches": "factory-arguments"
                      },
                      {
                        "matches": "factory-wrapper"
                      }
                    ]
                  }
                }
              ]
            },
            "ownership-scope": {
              "any": [
                {
                  "kind": "program"
                },
                {
                  "kind": "statement_block"
                },
                {
                  "kind": "switch_body"
                },
                {
                  "kind": "for_statement"
                },
                {
                  "kind": "for_in_statement"
                },
                {
                  "kind": "catch_clause"
                },
                {
                  "kind": "function_declaration"
                },
                {
                  "kind": "function_expression"
                },
                {
                  "kind": "arrow_function"
                },
                {
                  "kind": "generator_function"
                },
                {
                  "kind": "generator_function_declaration"
                },
                {
                  "kind": "method_definition"
                },
                {
                  "kind": "with_statement"
                }
              ]
            },
            "named-first-argument": {
              "all": [
                {
                  "kind": "identifier",
                  "pattern": "$CREATOR"
                },
                {
                  "nthChild": {
                    "position": 1,
                    "ofRule": {
                      "not": {
                        "kind": "comment"
                      }
                    }
                  }
                },
                {
                  "inside": {
                    "any": [
                      {
                        "matches": "factory-arguments"
                      },
                      {
                        "matches": "factory-wrapper"
                      }
                    ]
                  }
                }
              ]
            },
            "named-creator": {
              "all": [
                {
                  "any": [
                    {
                      "kind": "arrow_function"
                    },
                    {
                      "kind": "function_expression"
                    }
                  ]
                },
                {
                  "inside": {
                    "field": "value",
                    "stopBy": {
                      "not": {
                        "any": [
                          {
                            "kind": "parenthesized_expression"
                          },
                          {
                            "kind": "as_expression"
                          },
                          {
                            "kind": "satisfies_expression"
                          },
                          {
                            "kind": "non_null_expression"
                          }
                        ]
                      }
                    },
                    "kind": "variable_declarator",
                    "all": [
                      {
                        "has": {
                          "field": "name",
                          "kind": "identifier",
                          "pattern": "$CREATOR"
                        }
                      },
                      {
                        "any": [
                          {
                            "precedes": {
                              "stopBy": "end",
                              "has": {
                                "stopBy": {
                                  "matches": "ownership-scope"
                                },
                                "matches": "named-first-argument"
                              }
                            }
                          },
                          {
                            "inside": {
                              "kind": "lexical_declaration",
                              "has": {
                                "regex": "^const$"
                              },
                              "precedes": {
                                "stopBy": "end",
                                "has": {
                                  "stopBy": {
                                    "matches": "ownership-scope"
                                  },
                                  "matches": "named-first-argument"
                                }
                              }
                            }
                          }
                        ]
                      }
                    ],
                    "inside": {
                      "kind": "lexical_declaration",
                      "has": {
                        "regex": "^const$"
                      }
                    }
                  }
                },
                {
                  "inside": {
                    "stopBy": {
                      "matches": "ownership-scope"
                    },
                    "matches": "ownership-scope",
                    "has": {
                      "stopBy": {
                        "matches": "ownership-scope"
                      },
                      "matches": "named-first-argument"
                    }
                  }
                }
              ]
            },
            "named-root": {
              "all": [
                {
                  "matches": "named-creator"
                },
                {
                  "not": {
                    "inside": {
                      "stopBy": {
                        "matches": "ownership-scope"
                      },
                      "matches": "ownership-scope",
                      "has": {
                        "stopBy": {
                          "matches": "ownership-scope"
                        },
                        "matches": "named-direct-call"
                      }
                    }
                  }
                },
                {
                  "not": {
                    "inside": {
                      "stopBy": {
                        "matches": "ownership-scope"
                      },
                      "kind": "export_statement"
                    }
                  }
                },
                {
                  "not": {
                    "inside": {
                      "stopBy": {
                        "matches": "ownership-scope"
                      },
                      "matches": "ownership-scope",
                      "has": {
                        "stopBy": {
                          "matches": "ownership-scope"
                        },
                        "matches": "named-export-reference"
                      }
                    }
                  }
                }
              ]
            },
            "named-export-reference": {
              "any": [
                {
                  "kind": "export_specifier",
                  "has": {
                    "field": "name",
                    "pattern": "$CREATOR"
                  },
                  "not": {
                    "has": {
                      "regex": "^type$"
                    }
                  },
                  "inside": {
                    "kind": "export_statement",
                    "stopBy": "end",
                    "not": {
                      "any": [
                        {
                          "has": {
                            "field": "source",
                            "regex": ".+"
                          }
                        },
                        {
                          "regex": "^export\\s+type\\b"
                        }
                      ]
                    }
                  }
                },
                {
                  "kind": "export_statement",
                  "has": {
                    "field": "value",
                    "matches": "named-export-value"
                  }
                }
              ]
            },
            "named-export-value": {
              "any": [
                {
                  "kind": "identifier",
                  "pattern": "$CREATOR"
                },
                {
                  "any": [
                    {
                      "kind": "parenthesized_expression"
                    },
                    {
                      "kind": "as_expression"
                    },
                    {
                      "kind": "satisfies_expression"
                    },
                    {
                      "kind": "non_null_expression"
                    }
                  ],
                  "has": {
                    "nthChild": {
                      "position": 1,
                      "ofRule": {
                        "not": {
                          "kind": "comment"
                        }
                      }
                    },
                    "matches": "named-export-value"
                  }
                }
              ]
            },
            "named-direct-call": {
              "kind": "identifier",
              "pattern": "$CREATOR",
              "inside": {
                "field": "function",
                "stopBy": {
                  "not": {
                    "any": [
                      {
                        "kind": "parenthesized_expression"
                      },
                      {
                        "kind": "as_expression"
                      },
                      {
                        "kind": "satisfies_expression"
                      },
                      {
                        "kind": "non_null_expression"
                      }
                    ]
                  }
                },
                "kind": "call_expression"
              }
            },
            "creator-member": {
              "any": [
                {
                  "kind": "member_expression",
                  "all": [
                    {
                      "has": {
                        "field": "property",
                        "regex": "^(addFactoryMethod)$"
                      }
                    }
                  ]
                },
                {
                  "kind": "subscript_expression",
                  "all": [
                    {
                      "has": {
                        "field": "index",
                        "regex": "^[\\\"'`](addFactoryMethod)[\\\"'`]$"
                      }
                    }
                  ]
                },
                {
                  "any": [
                    {
                      "kind": "parenthesized_expression"
                    },
                    {
                      "kind": "as_expression"
                    },
                    {
                      "kind": "satisfies_expression"
                    },
                    {
                      "kind": "non_null_expression"
                    }
                  ],
                  "has": {
                    "nthChild": {
                      "position": 1,
                      "ofRule": {
                        "not": {
                          "kind": "comment"
                        }
                      }
                    },
                    "matches": "creator-member"
                  }
                }
              ]
            },
            "factory-arguments": {
              "kind": "arguments",
              "inside": {
                "kind": "call_expression",
                "has": {
                  "field": "function",
                  "matches": "creator-member"
                }
              }
            },
            "factory-wrapper": {
              "all": [
                {
                  "any": [
                    {
                      "kind": "parenthesized_expression"
                    },
                    {
                      "kind": "as_expression"
                    },
                    {
                      "kind": "satisfies_expression"
                    },
                    {
                      "kind": "non_null_expression"
                    }
                  ]
                },
                {
                  "nthChild": {
                    "position": 1,
                    "ofRule": {
                      "not": {
                        "kind": "comment"
                      }
                    }
                  }
                },
                {
                  "inside": {
                    "any": [
                      {
                        "matches": "factory-arguments"
                      },
                      {
                        "matches": "factory-wrapper"
                      }
                    ]
                  }
                }
              ]
            }
          },
          "rule": {
            "kind": "new_expression",
            "not": {
              "any": [
                {
                  "inside": {
                    "field": "body",
                    "kind": "arrow_function",
                    "matches": "factory"
                  }
                },
                {
                  "inside": {
                    "kind": "return_statement",
                    "inside": {
                      "kind": "statement_block",
                      "inside": {
                        "matches": "factory"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "Managed components must resolve collaborators through the injected kernel instead of constructing them directly."
  }
}
