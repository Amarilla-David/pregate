{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "mattpocock/diagnostics/no-tagged-debug-log",
  "version": "1.0.0",
  "area": "diagnostics",
  "cardinality": "singleton",
  "dimension": "diagnostics.tagged-debug-log",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "tagged-debug-log",
          "rule": {
            "kind": "call_expression",
            "has": {
              "field": "function",
              "kind": "member_expression",
              "all": [
                {
                  "has": {
                    "field": "object",
                    "regex": "^console$"
                  }
                },
                {
                  "has": {
                    "field": "property",
                    "regex": "^(log|debug|info|warn|error|trace)$"
                  }
                }
              ]
            },
            "all": [
              {
                "has": {
                  "field": "arguments",
                  "has": {
                    "any": [
                      {
                        "kind": "string"
                      },
                      {
                        "kind": "template_string"
                      }
                    ],
                    "regex": "^['\"`]\\[DEBUG-[^\\]]+\\]"
                  }
                }
              }
            ]
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} retains a [DEBUG-...] console log. Remove it when diagnosis is complete."
  }
}
