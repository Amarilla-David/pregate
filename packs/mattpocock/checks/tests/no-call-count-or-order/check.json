{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "mattpocock/tests/no-call-count-or-order",
  "version": "1.0.0",
  "area": "tests",
  "cardinality": "singleton",
  "dimension": "tests.call-count-order",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "call-count-or-order",
          "rule": {
            "kind": "call_expression",
            "has": {
              "field": "function",
              "kind": "member_expression",
              "all": [
                {
                  "has": {
                    "field": "object",
                    "regex": "^expect\\s*\\("
                  }
                },
                {
                  "has": {
                    "field": "property",
                    "regex": "^(toHaveBeenCalledTimes|toHaveBeenNthCalledWith|toHaveBeenLastCalledWith|toHaveBeenCalledBefore|toHaveBeenCalledAfter)$"
                  }
                }
              ]
            }
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} asserts collaborator call counts or ordering. Review whether this is observable behavior at the seam."
  }
}
