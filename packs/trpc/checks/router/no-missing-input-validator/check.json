{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "trpc/router/no-missing-input-validator",
  "version": "1.0.0",
  "area": "router",
  "cardinality": "singleton",
  "dimension": "trpc.input-validator",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "query-or-mutation-without-input",
          "rule": {
            "kind": "call_expression",
            "regex": "^publicProcedure[\\s\\S]*\\.(query|mutation)\\s*\\(",
            "not": {
              "regex": "\\.input\\s*\\("
            }
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} runs a query or mutation with no .input validator. Declare .input before the resolver so unvalidated caller data never reaches it."
  }
}
