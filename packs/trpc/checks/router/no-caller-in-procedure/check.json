{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "trpc/router/no-caller-in-procedure",
  "version": "1.0.0",
  "area": "router",
  "cardinality": "singleton",
  "dimension": "trpc.caller-in-procedure",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "caller-in-procedure",
          "rule": {
            "kind": "call_expression",
            "any": [
              {
                "has": {
                  "field": "function",
                  "regex": "(^|\\.)createCaller$"
                }
              },
              {
                "has": {
                  "field": "function",
                  "kind": "call_expression",
                  "has": {
                    "field": "function",
                    "regex": "(^|\\.)createCallerFactory$"
                  }
                }
              }
            ],
            "inside": {
              "stopBy": "end",
              "kind": "call_expression",
              "has": {
                "field": "function",
                "kind": "member_expression",
                "has": {
                  "field": "property",
                  "regex": "^(query|mutation|subscription)$"
                }
              }
            }
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} creates a tRPC caller inside a procedure, which rebuilds context and reruns middleware and input validation. Extract the shared logic into a function both procedures call."
  }
}
