{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "trpc/middleware/no-unreturned-next",
  "version": "1.0.0",
  "area": "middleware",
  "cardinality": "singleton",
  "dimension": "trpc.unreturned-next",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "unreturned-middleware-next",
          "rule": {
            "kind": "expression_statement",
            "has": {
              "any": [
                {
                  "kind": "call_expression",
                  "all": [
                    {
                      "has": {
                        "field": "function",
                        "regex": "^(opts\\.)?next$"
                      }
                    },
                    {
                      "has": {
                        "field": "arguments",
                        "any": [
                          {
                            "regex": "^\\(\\s*\\)$"
                          },
                          {
                            "has": {
                              "nthChild": 1,
                              "kind": "object"
                            }
                          }
                        ]
                      }
                    }
                  ]
                },
                {
                  "kind": "await_expression",
                  "has": {
                    "kind": "call_expression",
                    "all": [
                      {
                        "has": {
                          "field": "function",
                          "regex": "^(opts\\.)?next$"
                        }
                      },
                      {
                        "has": {
                          "field": "arguments",
                          "any": [
                            {
                              "regex": "^\\(\\s*\\)$"
                            },
                            {
                              "has": {
                                "nthChild": 1,
                                "kind": "object"
                              }
                            }
                          ]
                        }
                      }
                    ]
                  }
                }
              ]
            },
            "inside": {
              "stopBy": {
                "kind": "@fn"
              },
              "kind": "@fn",
              "not": {
                "has": {
                  "field": "parameters",
                  "kind": "formal_parameters",
                  "has": {
                    "nthChild": 2
                  }
                }
              },
              "inside": {
                "kind": "arguments",
                "inside": {
                  "kind": "call_expression",
                  "has": {
                    "field": "function",
                    "kind": "member_expression",
                    "has": {
                      "field": "property",
                      "regex": "^(middleware|use)$"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} calls next() in a tRPC middleware without returning or capturing its result. Return next(...) so downstream procedure results and context propagate."
  }
}
