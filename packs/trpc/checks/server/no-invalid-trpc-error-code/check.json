{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "trpc/server/no-invalid-trpc-error-code",
  "version": "1.0.0",
  "area": "server",
  "cardinality": "singleton",
  "dimension": "trpc.error-code",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "invalid-trpc-error-code",
          "rule": {
            "kind": "new_expression",
            "all": [
              {
                "has": {
                  "field": "constructor",
                  "regex": "(^|\\.)TRPCError$"
                }
              },
              {
                "has": {
                  "field": "arguments",
                  "has": {
                    "kind": "object",
                    "has": {
                      "kind": "pair",
                      "all": [
                        {
                          "has": {
                            "field": "key",
                            "regex": "^['\"]?code['\"]?$"
                          }
                        },
                        {
                          "has": {
                            "field": "value",
                            "any": [
                              {
                                "kind": "number"
                              },
                              {
                                "any": [
                                  {
                                    "kind": "string"
                                  },
                                  {
                                    "kind": "template_string"
                                  }
                                ],
                                "not": {
                                  "regex": "^['\"`](PARSE_ERROR|BAD_REQUEST|INTERNAL_SERVER_ERROR|NOT_IMPLEMENTED|BAD_GATEWAY|SERVICE_UNAVAILABLE|GATEWAY_TIMEOUT|UNAUTHORIZED|PAYMENT_REQUIRED|FORBIDDEN|NOT_FOUND|METHOD_NOT_SUPPORTED|TIMEOUT|CONFLICT|PRECONDITION_FAILED|PAYLOAD_TOO_LARGE|UNSUPPORTED_MEDIA_TYPE|UNPROCESSABLE_ENTITY|UNPROCESSABLE_CONTENT|TOO_MANY_REQUESTS|CLIENT_CLOSED_REQUEST)['\"`]$"
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} passes an invalid literal code to TRPCError. Use one of the official uppercase TRPC_ERROR_CODE_KEY strings (e.g. 'NOT_FOUND', 'UNAUTHORIZED', 'BAD_REQUEST')."
  }
}
