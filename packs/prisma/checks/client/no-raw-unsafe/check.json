{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "prisma/client/no-raw-unsafe",
  "version": "1.1.0",
  "area": "client",
  "cardinality": "singleton",
  "dimension": "prisma.raw-unsafe",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "raw-unsafe",
          "rule": {
            "kind": "call_expression",
            "all": [
              {
                "has": {
                  "field": "function",
                  "regex": "\\$(queryRawUnsafe|executeRawUnsafe)"
                }
              },
              {
                "has": {
                  "field": "arguments",
                  "has": {
                    "nthChild": {
                      "position": 1,
                      "ofRule": {
                        "not": {
                          "kind": "comment"
                        }
                      }
                    },
                    "not": {
                      "any": [
                        {
                          "kind": "string"
                        },
                        {
                          "kind": "template_string",
                          "not": {
                            "has": {
                              "kind": "template_substitution"
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} passes SQL built at runtime to an Unsafe raw query. Use the $queryRaw or $executeRaw template form, or a constant SQL string with $1 placeholders and the values as extra arguments."
  }
}
