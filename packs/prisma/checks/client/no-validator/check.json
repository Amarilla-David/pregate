{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "prisma/client/no-validator",
  "version": "1.0.0",
  "area": "client",
  "cardinality": "singleton",
  "dimension": "prisma.validator",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "prisma-validator",
          "since": {
            "dependencies": ["@prisma/client", "prisma"],
            "version": "7.0.0"
          },
          "rule": {
            "kind": "call_expression",
            "has": {
              "field": "function",
              "any": [
                {
                  "kind": "member_expression",
                  "all": [
                    {
                      "has": {
                        "field": "object",
                        "regex": "^Prisma$"
                      }
                    },
                    {
                      "has": {
                        "field": "property",
                        "regex": "^validator$"
                      }
                    }
                  ]
                },
                {
                  "kind": "subscript_expression",
                  "all": [
                    {
                      "has": {
                        "field": "object",
                        "regex": "^Prisma$"
                      }
                    },
                    {
                      "has": {
                        "field": "index",
                        "regex": "^[\"'`]validator[\"'`]$"
                      }
                    }
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  },
  "phase": ["pre", "stop", "commit", "ci"],
  "feedback": {
    "message": "{symbol} calls Prisma.validator, which the default prisma-client generator does not provide. Write the object with satisfies."
  }
}
