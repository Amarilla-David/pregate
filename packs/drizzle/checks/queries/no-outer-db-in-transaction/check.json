{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "drizzle/queries/no-outer-db-in-transaction",
  "version": "1.0.0",
  "area": "queries",
  "cardinality": "singleton",
  "dimension": "drizzle.transaction-client",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "outer-db-in-transaction",
          "rule": {
            "kind": "call_expression",
            "all": [
              {
                "has": {
                  "field": "function",
                  "kind": "member_expression",
                  "all": [
                    {
                      "has": {
                        "field": "object",
                        "pattern": "$DB"
                      }
                    },
                    {
                      "has": {
                        "field": "property",
                        "regex": "^transaction$"
                      }
                    }
                  ]
                }
              },
              {
                "has": {
                  "field": "arguments",
                  "has": {
                    "any": [
                      {
                        "kind": "arrow_function"
                      },
                      {
                        "kind": "function_expression"
                      }
                    ],
                    "all": [
                      {
                        "not": {
                          "has": {
                            "field": "parameters",
                            "has": {
                              "stopBy": "end",
                              "pattern": "$DB"
                            }
                          }
                        }
                      },
                      {
                        "not": {
                          "has": {
                            "field": "parameter",
                            "pattern": "$DB"
                          }
                        }
                      },
                      {
                        "has": {
                          "stopBy": "end",
                          "kind": "call_expression",
                          "has": {
                            "field": "function",
                            "kind": "member_expression",
                            "any": [
                              {
                                "all": [
                                  {
                                    "has": {
                                      "field": "object",
                                      "pattern": "$DB"
                                    }
                                  },
                                  {
                                    "has": {
                                      "field": "property",
                                      "regex": "^(select|selectDistinct|selectDistinctOn|insert|update|delete|execute|run|all|get|values|\\$count)$"
                                    }
                                  }
                                ]
                              },
                              {
                                "all": [
                                  {
                                    "has": {
                                      "field": "object",
                                      "kind": "member_expression",
                                      "has": {
                                        "field": "object",
                                        "kind": "member_expression",
                                        "all": [
                                          {
                                            "has": {
                                              "field": "object",
                                              "pattern": "$DB"
                                            }
                                          },
                                          {
                                            "has": {
                                              "field": "property",
                                              "regex": "^query$"
                                            }
                                          }
                                        ]
                                      }
                                    }
                                  },
                                  {
                                    "has": {
                                      "field": "property",
                                      "regex": "^(findMany|findFirst)$"
                                    }
                                  }
                                ]
                              }
                            ]
                          }
                        }
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} queries the outer db inside a transaction callback. Run the query on the callback's tx so it commits or rolls back with the transaction."
  }
}
