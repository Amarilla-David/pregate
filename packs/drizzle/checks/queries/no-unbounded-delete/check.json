{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "drizzle/queries/no-unbounded-delete",
  "version": "1.0.0",
  "area": "queries",
  "cardinality": "singleton",
  "dimension": "drizzle.unbounded-delete",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "drizzle-delete-without-where",
          "rule": {
            "kind": "call_expression",
            "has": {
              "field": "function",
              "kind": "member_expression",
              "all": [
                {
                  "has": {
                    "field": "object",
                    "regex": "^(db|tx)$"
                  }
                },
                {
                  "has": {
                    "field": "property",
                    "regex": "^delete$"
                  }
                }
              ]
            },
            "not": {
              "inside": {
                "stopBy": "end",
                "kind": "call_expression",
                "has": {
                  "field": "function",
                  "kind": "member_expression",
                  "has": {
                    "field": "property",
                    "regex": "^where$"
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} calls db.delete(table) without chaining .where(...), which deletes every row in the table."
  }
}
