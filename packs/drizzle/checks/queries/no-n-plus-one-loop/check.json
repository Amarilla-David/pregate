{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "drizzle/queries/no-n-plus-one-loop",
  "version": "1.0.0",
  "area": "queries",
  "cardinality": "singleton",
  "dimension": "drizzle.loop-query",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "loop-query",
          "rule": {
            "kind": "await_expression",
            "regex": "\\bdb\\.",
            "inside": {
              "stopBy": "end",
              "any": [
                {
                  "kind": "for_statement"
                },
                {
                  "kind": "for_in_statement"
                },
                {
                  "kind": "while_statement"
                }
              ]
            }
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} awaits a db query inside a loop. Load the related rows with one relational with: query or a join."
  }
}
