{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "angular/rxjs/no-nested-subscribe",
  "version": "1.0.0",
  "area": "rxjs",
  "cardinality": "singleton",
  "dimension": "angular.nested-subscribe",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "nested-subscribe",
          "rule": {
            "kind": "call_expression",
            "has": {
              "field": "function",
              "regex": "\\.subscribe$"
            },
            "inside": {
              "stopBy": "end",
              "kind": "call_expression",
              "regex": "\\.subscribe\\("
            }
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} subscribes inside another subscribe callback. Flatten the stream with switchMap or mergeMap instead."
  }
}
