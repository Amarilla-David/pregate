{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "angular/rxjs/no-topromise",
  "version": "1.0.0",
  "area": "rxjs",
  "cardinality": "singleton",
  "dimension": "angular.topromise",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "topromise-call",
          "rule": {
            "kind": "call_expression",
            "has": {
              "field": "function",
              "regex": "\\.toPromise$"
            }
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} calls deprecated toPromise. Use firstValueFrom or lastValueFrom instead."
  }
}
