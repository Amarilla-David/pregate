{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "angular/signals/no-signal-write-in-computed",
  "version": "1.0.0",
  "area": "signals",
  "cardinality": "singleton",
  "dimension": "angular.signal-write-in-computed",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "signal-write-in-computed",
          "rule": {
            "kind": "call_expression",
            "has": {
              "field": "function",
              "regex": "\\.(set|update)$"
            },
            "inside": {
              "stopBy": "end",
              "kind": "call_expression",
              "regex": "\\bcomputed\\s*\\("
            }
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} writes a signal inside computed. A computed must be pure; move the write into an effect or handler."
  }
}
