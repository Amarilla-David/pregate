{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "nextjs/data/no-fetch-without-cache",
  "version": "1.1.0",
  "area": "data",
  "cardinality": "singleton",
  "dimension": "nextjs.no-fetch-without-cache",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "fetch-cache",
          "when": { "cacheComponents": "off" },
          "rule": {
            "kind": "call_expression",
            "has": {
              "field": "function",
              "regex": "^fetch$"
            },
            "not": {
              "has": {
                "field": "arguments",
                "regex": "\\b(cache|revalidate|next)\\b"
              }
            }
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} fetches without a cache, revalidate, or next option. In the previous model the default is auto no cache; set cache or next.revalidate only to choose an explicit policy."
  }
}
