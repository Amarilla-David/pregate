{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "nextjs/rendering/no-client-metadata-export",
  "version": "1.0.0",
  "area": "rendering",
  "cardinality": "singleton",
  "dimension": "nextjs.no-client-metadata-export",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "client-metadata-export",
          "files": [
            "app/**/page.*",
            "app/**/layout.*",
            "src/app/**/page.*",
            "src/app/**/layout.*"
          ],
          "rule": {
            "kind": "identifier",
            "regex": "^(metadata|generateMetadata)$",
            "all": [
              {
                "any": [
                  {
                    "inside": {
                      "field": "name",
                      "kind": "variable_declarator",
                      "inside": {
                        "any": [
                          {
                            "kind": "lexical_declaration"
                          },
                          {
                            "kind": "variable_declaration"
                          }
                        ],
                        "inside": {
                          "kind": "export_statement"
                        }
                      }
                    }
                  },
                  {
                    "inside": {
                      "field": "name",
                      "kind": "function_declaration",
                      "inside": {
                        "kind": "export_statement"
                      }
                    }
                  },
                  {
                    "nthChild": {
                      "position": 1,
                      "reverse": true
                    },
                    "inside": {
                      "kind": "export_specifier"
                    }
                  }
                ]
              },
              {
                "inside": {
                  "kind": "program",
                  "stopBy": "end",
                  "has": {
                    "kind": "expression_statement",
                    "regex": "^[\"']use client[\"'];?$",
                    "not": {
                      "follows": {
                        "stopBy": "end",
                        "not": {
                          "any": [
                            {
                              "kind": "comment"
                            },
                            {
                              "kind": "hash_bang_line"
                            },
                            {
                              "kind": "expression_statement",
                              "regex": "^[\"'][^\"']*[\"'];?$"
                            }
                          ]
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    }
  },
  "phase": [
    "pre",
    "stop",
    "commit",
    "ci"
  ],
  "feedback": {
    "message": "{symbol} is exported from a 'use client' page or layout. Next.js reads metadata only from Server Components; move the client code into a child component and keep the export on the server file."
  }
}
