{
  "$schema": "../../../../../schema/check.v1.json",
  "id": "nextjs/routing/no-nodejs-middleware-file",
  "version": "1.0.0",
  "area": "routing",
  "cardinality": "singleton",
  "dimension": "nextjs.nodejs-middleware-file",
  "minSeverity": null,
  "params": {},
  "impl": {
    "kind": "pattern",
    "patterns": {
      "typescript": [
        {
          "id": "nodejs-middleware-runtime",
          "files": [
            "middleware.ts",
            "middleware.tsx",
            "middleware.js",
            "middleware.jsx",
            "middleware.mjs",
            "middleware.cjs",
            "src/middleware.ts",
            "src/middleware.tsx",
            "src/middleware.js",
            "src/middleware.jsx",
            "src/middleware.mjs",
            "src/middleware.cjs"
          ],
          "rule": {
            "kind": "pair",
            "regex": "^runtime\\s*:\\s*['\"`]nodejs['\"`]",
            "inside": {
              "kind": "object",
              "inside": {
                "field": "value",
                "kind": "variable_declarator",
                "has": { "field": "name", "regex": "^config$" },
                "inside": {
                  "kind": "lexical_declaration",
                  "inside": { "kind": "export_statement" }
                }
              }
            }
          }
        }
      ]
    }
  },
  "phase": ["pre", "stop", "commit", "ci"],
  "feedback": {
    "message": "{symbol}: rename Node middleware.ts to proxy.ts and export proxy. https://nextjs.org/docs/app/guides/upgrading/version-16"
  }
}
