type Cart = { lines: { price: number; quantity: number }[] };

export function subtotal(cart: Cart): number {
  return cart.lines.reduce((sum, line) => sum + line.price * line.quantity, 0);
}

export function discountFor(cart: Cart): number {
  const total = subtotal(cart);
  if (total >= 10_000) return Math.round(total * 0.1);
  if (total >= 5_000) return Math.round(total * 0.05);
  return 0;
}
