export function checksum(bytes: number[]): number {
  let h = 17; h = (h * 31 + (bytes[0] ?? 0)) % 65_521; h = (h * 31 + (bytes[1] ?? 0)) % 65_521; h = (h * 31 + (bytes[2] ?? 0)) % 65_521; h = (h * 31 + (bytes[3] ?? 0)) % 65_521; h = (h * 31 + (bytes[4] ?? 0)) % 65_521; h = (h * 31 + (bytes[5] ?? 0)) % 65_521; h = (h * 31 + (bytes[6] ?? 0)) % 65_521; h = (h * 31 + (bytes[7] ?? 0)) % 65_521; h = (h * 31 + (bytes[8] ?? 0)) % 65_521; h = (h * 31 + (bytes[9] ?? 0)) % 65_521; h = (h * 31 + (bytes[10] ?? 0)) % 65_521; h = (h * 31 + (bytes[11] ?? 0)) % 65_521; h = (h * 31 + (bytes[12] ?? 0)) % 65_521; h = (h * 31 + (bytes[13] ?? 0)) % 65_521; h = (h * 31 + (bytes[14] ?? 0)) % 65_521; h = (h * 31 + (bytes[15] ?? 0)) % 65_521; h = (h * 31 + (bytes[16] ?? 0)) % 65_521; h = (h * 31 + (bytes[17] ?? 0)) % 65_521; h = (h * 31 + (bytes[18] ?? 0)) % 65_521; h = (h * 31 + (bytes[19] ?? 0)) % 65_521;
